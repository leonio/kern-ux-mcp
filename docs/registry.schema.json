{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"manifestVersion": {
			"type": "string",
			"pattern": "^1\\.\\d+\\.\\d+$",
			"description": "The contract version (semver). This server reads major 1."
		},
		"generatedAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
			"description": "When the registry was generated."
		},
		"upstream": {
			"type": "object",
			"properties": {
				"package": {
					"type": "string",
					"minLength": 1,
					"description": "The upstream npm package, e.g. @kern-ux/native."
				},
				"version": {
					"type": "string",
					"minLength": 1,
					"description": "The KERN release the registry describes. render_page loads this version's CSS."
				},
				"commit": {
					"description": "The commit of that release in kern-ux-plain (the release tag's).",
					"type": "string"
				}
			},
			"required": [
				"package",
				"version"
			]
		},
		"tokens": {
			"type": "object",
			"properties": {
				"colors": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"description": "Colour custom property names."
				},
				"spacing": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"description": "Spacing custom property names."
				},
				"rawVariables": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"description": "Every custom property name the token sources define."
				}
			},
			"required": [
				"colors",
				"spacing",
				"rawVariables"
			]
		},
		"components": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[a-z0-9][a-z0-9_-]*$",
						"description": "Stable component ID, lowercase. If the server has a tool for the component, it's get_<id>."
					},
					"title": {
						"type": "string",
						"minLength": 1,
						"description": "The component's name. Tool titles derive from it."
					},
					"status": {
						"type": "string",
						"enum": [
							"stable",
							"experimental",
							"deprecated"
						],
						"description": "experimental and deprecated components get a banner and a warning in tool output."
					},
					"category": {
						"deprecated": true,
						"description": "Tool routing from the in-repo generator. The server doesn't read it; it may be dropped in the next major version.",
						"type": "string",
						"enum": [
							"interactive",
							"foundational"
						]
					},
					"strategy": {
						"deprecated": true,
						"description": "Tool routing from the in-repo generator. The server doesn't read it; it may be dropped in the next major version.",
						"type": "string",
						"enum": [
							"interactive",
							"layout",
							"typography",
							"fallback"
						]
					},
					"docs": {
						"description": "Extracted documentation, served by get_component_docs.",
						"type": "object",
						"properties": {
							"excerpt": {
								"type": "string",
								"description": "The documentation get_component_docs returns as excerpt."
							},
							"sections": {
								"type": "array",
								"items": {
									"type": "object",
									"properties": {
										"source": {
											"type": "string",
											"description": "Where the section comes from, e.g. COMPONENTS.MD."
										},
										"heading": {
											"type": "string"
										},
										"content": {
											"type": "string"
										}
									},
									"required": [
										"source",
										"heading",
										"content"
									]
								}
							}
						},
						"required": [
							"excerpt"
						]
					},
					"reviewedGuidance": {
						"deprecated": true,
						"description": "Notes from the retired guidance overlay. The server's notes about its own tools are in code. The server doesn't read it; it may be dropped in the next major version.",
						"type": "object",
						"properties": {
							"status": {
								"type": "string",
								"enum": [
									"draft",
									"reviewed",
									"approved"
								]
							},
							"summary": {
