{
	"extends": ["config:recommended", "schedule:weekly"],
	"labels": ["dependencies"],
	"dependencyDashboard": true,
	"prConcurrentLimit": 5,
	"prHourlyLimit": 2,
	"automerge": false,
	"packageRules": [
		{
			"description": "Group all development tooling together to save CI runs",
			"matchDepTypes": ["devDependencies"],
			"groupName": "Dev Dependencies (Tooling)",
			"matchPackageNames": [
				"/^@biomejs//",
				"/^vitest/",
				"/^tsx/",
				"/^typescript/",
				"/^@types//"
			]
		},
		{
			"description": "Force semantic commits so GitVersion bumps the patch number on main",
			"matchUpdateTypes": ["minor", "patch"],
			"semanticCommitType": "fix",
			"semanticCommitScope": "deps",
			"matchPackageNames": ["*"]
		},
		{
			"description": "Major updates should trigger a major version bump via breaking change syntax",
			"matchUpdateTypes": ["major"],
			"semanticCommitType": "feat",
			"semanticCommitScope": "deps",
			"commitMessageExtra": "!",
			"automerge": false
		}
	],
	"postUpgradeTasks": {
		"commands": ["npx @biomejs/biome format --write {{{depFileName}}}"],
		"fileFilters": ["**/*"],
		"executionMode": "branch"
	}
}
