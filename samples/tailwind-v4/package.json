{
	"name": "tailwind-v4-kern",
	"version": "1.0.0",
	"private": true,
	"description": "Tailwind CSS v4 themed with KERN-UX design tokens",
	"scripts": {
		"build": "tailwindcss -i ./src/app.css -o ./dist/app.css",
		"watch": "tailwindcss -i ./src/app.css -o ./dist/app.css --watch",
		"tokens": "node scripts/kern-tokens.mjs",
		"check": "node scripts/kern-tokens.mjs --check"
	},
	"devDependencies": {
		"@kern-ux/native": "2.8.2",
		"@tailwindcss/cli": "^4.3.3",
		"tailwindcss": "^4.3.3"
	},
	"engines": {
		"node": ">=24.16.0"
	}
}
