{
	"name": "kern-ux-mcp-workspace",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Workspace root for the Kern UX MCP server: the private core library and the published hosts.",
	"license": "EUPL-1.2",
	"author": "Leon Ioannides <leonio@users.noreply.github.com>",
	"homepage": "https://github.com/leonio/kern-ux-mcp#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/leonio/kern-ux-mcp.git"
	},
	"workspaces": [
		"packages/*"
	],
	"engines": {
		"node": ">=24.16.0"
	},
	"scripts": {
		"dev": "tsx --conditions=@leonio/source packages/stdio/src/index.ts",
		"dev:http": "tsx --conditions=@leonio/source packages/http/src/index.ts",
		"build": "npm run build -ws --if-present",
		"build:watch": "npm run build:watch -w packages/stdio",
		"start": "node packages/stdio/dist/index.js",
		"start:http": "node packages/http/dist/index.js",
		"docker:build": "docker build -f packages/http/Dockerfile -t kern-ux-mcp-http:dev .",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
		"loop:start": "npm run generate-manifest && pwsh -NoLogo -ExecutionPolicy Bypass -File ./tools/dev/dev-loop.ps1",
		"loop:full": "npm run generate-manifest && pwsh -NoLogo -ExecutionPolicy Bypass -File ./tools/dev/dev-loop.ps1 -WatchTests -WatchBuild -OpenSample -DebugMcp",
		"loop:stop": "pwsh -NoLogo -ExecutionPolicy Bypass -File ./tools/dev/dev-loop.ps1 -Stop",
		"validate-guidance-overlay": "tsx tools/manifest/validate-guidance-overlay.ts",
		"generate-manifest": "tsx tools/manifest/build-manifest.ts",
		"sbom": "npm run sbom -w packages/stdio -w packages/http",
		"sbom:generate": "syft scan dir:. --output cyclonedx-json=sbom.cyclonedx.json",
		"scan:vulns": "npm run sbom:generate && grype sbom:sbom.cyclonedx.json",
		"scan:vulns:high": "npm run sbom:generate && grype sbom:sbom.cyclonedx.json --fail-on high",
		"pack:inspect": "npm run build && npm pack --dry-run -w packages/stdio",
		"pack:release": "npm run build && npm pack -w packages/stdio",
		"pack:mcpb": "npm run build -w packages/stdio && npm run pack:mcpb -w packages/stdio",
		"sample:dev": "npm --prefix samples/basic-layout run dev",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "vitest run -c vitest.e2e.config.ts",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"version:json": "dotnet-gitversion /output json",
		"check-version": "dotnet-gitversion /version",
		"pre-commit": "npm run lint && npm run check-version",
		"registry:schema": "tsx tools/registry/export-schema.ts",
		"registry:import": "tsx tools/registry/import.ts",
		"listing:sizes": "tsx tools/listing/sizes.ts",
		"eval": "tsx tools/eval/run.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@modelcontextprotocol/client": "^2.1.0",
		"@types/node": "^24.13.3",
		"@vitest/coverage-v8": "^5.0.2",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"esbuild": "^0.28.2",
		"fast-glob": "^3.3.3",
		"tsx": "^4.23.12",
		"typescript": "^7.0.0",
		"vitest": "^5.0.0"
	}
}
