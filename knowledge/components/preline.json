  },
  "docs": {
    "url": "https://www.kern-ux.de/komponenten/text/preline",
    "summary": {
      "en": "Preline adds short supporting information to a Title or Heading. It is a text component that gives the heading below it more context while staying visually and hierarchically in the background, and it is never used on its own. It comes in three sizes: large, default and small. Match the size to the heading or title below it and place the Preline directly above that heading with no extra spacing, since the vertical rhythm is already in the styles."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/text/preline#kurzbeschreibung",
        "summary": {
          "en": "Adds explanatory information to a Title or Heading."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/text/preline#beschreibung",
        "summary": {
          "en": "Usually a short explanatory text that deepens the context of the Heading or Title below it. It sits above that heading, stays visually and hierarchically in the background, and comes in three sizes: large, default and small."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/text/preline#verwendungsregeln",
        "summary": {
          "en": "Use Preline to mark a topic area, category or introduction above a title. It is never standalone and always pairs with the Title or Heading below it; match its size to that heading and place it directly above with no extra spacing, since the styles already handle the vertical rhythm."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/text/preline#dos-und-donts",
        "summary": {
          "en": "Keep the text short and to the point, for example a context hint or a category. Do not use Preline as a standalone heading, for longer explanations or body copy, without a clear link to the heading that follows, with extra bold or italic styling, with inconsistent sizes, or to structure the page."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Adds short supporting text above a Title or Heading; never used standalone."
    },
    "whenToUse": [
      {
        "en": "To mark a topic area, category or introduction above a title."
      }
    ],
    "dos": [
      {
        "en": "Keep the Preline text short and to the point, for example a context hint or a category label."
      }
    ],
    "donts": [
      {
        "en": "Do not use Preline as a standalone heading; it always supplements a Title or Heading."
      },
      {
        "en": "Do not use Preline for long explanations or running text; use the Body component for that."
      },
      {
        "en": "Do not use Preline without a clear link to the heading it belongs to."
      },
      {
        "en": "Do not add bold, italic or other text formatting; the style already provides it."
      },
      {
        "en": "Do not combine Preline with a size that differs from the heading or title it accompanies."
      },
      {
        "en": "Do not use Preline to structure the page; the Heading component is solely responsible for that."
      }
    ],
    "similar": [
