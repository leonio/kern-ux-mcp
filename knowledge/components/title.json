  "docs": {
    "url": "https://www.kern-ux.de/komponenten/text/title",
    "summary": {
      "en": "Title is used for headings inside components, such as Cards, Dialogs or form sections, in three sizes: small, default and large. It gives visual structure inside UI elements and helps users orient themselves quickly; it usually holds a short, concise text placed above the content it refers to. Visual structure is also content structure, so a Title must be marked up with a matching HTML heading element, as WCAG and BITV require."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/text/title#kurzbeschreibung",
        "summary": {
          "en": "Used for headings inside components."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/text/title#beschreibung",
        "summary": {
          "en": "Suited to headings inside components such as Cards, Dialogs or form sections, and available in three sizes: small, default and large. It provides visual structure inside UI elements and helps users orient themselves, usually holding a short, concise text placed above the content it refers to."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/text/title#verwendungsregeln",
        "summary": {
          "en": "Use Title to name components concisely, such as Dialogs, form groups or Cards. Mark it up with a matching HTML heading element, as WCAG and BITV require. Use large for prominent titles, default for form sections and small for compact layouts."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/text/title#dos-und-donts",
        "summary": {
          "en": "Use Title to name a section inside a component clearly, and pick the size by available space and visual hierarchy. Do not add extra formatting such as bold, do not use Title for longer explanations, and do not make it the only cue for a section's function."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Heading for components such as Cards, Dialogs or form sections; needs a matching HTML heading level."
    },
    "whenToUse": [
      {
        "en": "To name a section inside a component clearly, such as in Dialogs, form groups or Cards."
      }
    ],
    "dos": [
      {
        "en": "Mark up a Title with a matching HTML heading level so the visual structure is also semantic."
      },
      {
        "en": "Choose the size (large, default, small) by available space and visual hierarchy."
      }
    ],
    "donts": [
      {
        "en": "Do not add extra formatting such as bold inside a Title; the style already highlights it."
      },
      {
        "en": "Do not use Title for longer texts or explanatory content; use the Body component."
      },
      {
        "en": "Do not rely on Title alone to convey a section's function; add semantic structure for accessible use."
      }
    ],
    "similar": [
      {
        "id": "heading"
      },
      {
        "id": "subline"
      }
    ]
  },
