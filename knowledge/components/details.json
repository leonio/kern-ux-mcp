  "examples": [
    {
      "id": "details",
      "html": {
        "markup": "<details class=\"kern-details\"><summary class=\"kern-details__header\"><span class=\"kern-title kern-title--small\">Details zu Punkt XY</span></summary><div class=\"kern-details__body\"><p class=\"kern-body\"> Das ist ein Beispiel für die Nutzung von <code>&lt;details&gt;</code> und <code>&lt;summary&gt;</code> für die progressive Offenlegung von Inhalten im Textfluss. Es ist eine native HTML-Lösung, die ohne JavaScript auskommt und von aktuellen Browsern und Screenreadern nativ unterstützt wird. Der eingeblendete Inhalt schiebt nachfolgende Elemente auf der Seite nach unten (Layout-Shift). </p></div></details>",
        "source": {
          "repo": "kern-ux-plain",
          "path": "stories/Details/Details.stories.js",
          "export": "Details"
        }
      }
    }
