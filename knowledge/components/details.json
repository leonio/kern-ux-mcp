  "docs": {
    "url": "https://www.kern-ux.de/komponenten/details",
    "summary": {
      "en": "Details reveals supplementary information that only some users need. The page covers the always-visible control and the collapsible region, suitable content such as explanations, help texts, background and legal notes, the rule to use it only when information is not required for the task, and where Accordion fits instead."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/details#kurzbeschreibung",
        "summary": {
          "en": "Reveals supplementary information that is relevant only to part of the users."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/details#beschreibung",
        "summary": {
          "en": "The component has a visible control for opening and closing and a collapsible content area. The control stays visible and describes the content; the expanded area can hold text, lists, links or further content."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/details#verwendungsregeln",
        "summary": {
          "en": "Show supplementary information only on demand: additional explanations, help texts, background information, legal notes or definitions. Reserve it for content relevant to only some users and not needed to understand or finish the task, and keep the summary short, clear and unambiguous."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/details#dos-und-donts",
        "summary": {
          "en": "Use Details only for supplementary information not needed to understand or complete a task. Label the control briefly and clearly, next to the content it relates to. One region per Details; use Accordion for several. Never hide important notes, error messages or mandatory information."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Reveals one region of supplementary information on demand; use Accordion for several independent regions."
    },
    "whenToUse": [
      {
        "en": "For supplementary content relevant to only some users, such as help texts, background, legal notes or definitions."
      }
    ],
    "dos": [
      {
        "en": "Use Details only for supplementary information that is not required to understand or finish a task."
      },
      {
        "en": "Label the control briefly, understandably and unambiguously."
      },
      {
        "en": "Place Details next to the content it relates to."
      },
      {
        "en": "Use Accordion when several related information regions should be expanded independently."
      }
    ],
    "donts": [
      {
        "en": "Do not hide important notes, error messages or mandatory information inside Details."
      },
      {
        "en": "Do not use general labels such as \"More\" or \"Details\" when they do not say what information appears."
      },
      {
        "en": "Do not place essential input elements or primary actions only inside Details."
      }
    ],
    "similar": [
