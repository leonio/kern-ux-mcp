  "docs": {
    "url": "https://www.kern-ux.de/komponenten/form-inputs/tel",
    "summary": {
      "en": "Input Tel takes a phone number. The field uses type=\"tel\", so mobile users get a numeric keypad, and it allows characters such as + for a country code. The label should state that a phone number is expected; if a particular format is required, the hint must explain the allowed characters. Validation errors appear below the field."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/tel#kurzbeschreibung",
        "summary": {
          "en": "Input Tel helps users enter a phone number."
        }
      },
      {
        "id": "disabled",
        "heading": "Disabled",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/tel#disabled",
        "summary": {
          "en": "Avoid disabled, since it restricts accessibility."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/tel#beschreibung",
        "summary": {
          "en": "The general input properties apply. type=\"tel\" gives mobile users a numeric keypad, and characters such as + for a country code are allowed. Keep the label clear about the expected value, optionally marked as optional, and use a hint for the format. Validation reports problems below the field."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/tel#verwendungsregeln",
        "summary": {
          "en": "Used in forms to enter a phone number; for general numbers Input Number fits better. The label should make clear that a phone number is expected, for example a mobile or landline number. If that is not obvious, the hint must explain the allowed characters and format."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/tel#dos-und-donts",
        "summary": {
          "en": "Use Input Tel only for phone numbers; for numbers in general Input Number is the better choice. Point users to the expected format. The general Input Dos and Don'ts also apply."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Input Tel takes a phone number with type=\"tel\" and allows digits plus characters such as +."
    },
    "whenToUse": [
      {
        "en": "Use Input Tel for phone numbers, such as a landline or mobile number, including international prefixes."
      }
    ],
    "dos": [
      {
        "en": "Use type=\"tel\" so mobile users get a numeric keypad."
      },
      {
        "en": "Tell users the expected format in the hint text."
      },
      {
        "en": "Make the label show that a phone number is expected, for example a mobile number."
      }
    ],
    "donts": [
      {
        "en": "Don't use Input Tel for general numbers; Input Number fits better."
      },
      {
        "en": "Don't use disabled, because it restricts accessibility."
      }
    ],
