{
  "id": "loader",
  "title": {
    "en": "Loader",
    "de": "Loader"
  },
  "status": "stable",
  "group": "feedback",
  "synonyms": {
    "de": [
      "Ladeanzeige",
      "Loading Indicator",
      "Spinner",
      "Wartekreisel",
      "Spinning Wheel",
      "Loading Spinner"
    ]
  },
  "links": {
    "docs": "https://www.kern-ux.de/komponenten/loader",
    "figma": "https://www.figma.com/community/file/1624024563231427311",
