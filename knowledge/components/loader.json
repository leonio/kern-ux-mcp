  },
  "docs": {
    "url": "https://www.kern-ux.de/komponenten/loader",
    "summary": {
      "en": "Loader is an animated spinning icon that tells users content is loading. It signals that a request is being processed and is used when the expected wait is unknown but likely longer than one second. A transparent white background (colour and transparency tokens in Figma) sits behind it so the loader stays clearly visible. Typical cases are fetching or refreshing search results, signing in to protected areas, downloads and loading large content such as videos."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/loader#kurzbeschreibung",
        "summary": {
          "en": "An animated, spinning icon that tells users that content is loading."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/loader#beschreibung",
        "summary": {
          "en": "Indicates that a loading or computation process is running. The icon animates continuously to signal to users that their request is being processed."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/loader#verwendungsregeln",
        "summary": {
          "en": "Use a loader when the expected wait is not exactly known but is likely to exceed one second. The component sits on a transparent white background (colour and transparency tokens in Figma) so it stays clearly visible."
        }
      },
      {
        "id": "beispiele",
        "heading": "Beispiele",
        "url": "https://www.kern-ux.de/komponenten/loader#beispiele",
        "summary": {
          "en": "Typical cases: fetching new or refreshed search results, signing in to protected areas, downloading content, and loading large content such as videos."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/loader#dos-und-donts",
        "summary": {
          "en": "Do not show a loading indicator when the wait is less than one second, and never use several loaders at the same time."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Animated spinner that signals an ongoing load; use it when the expected wait is not known but likely exceeds one second."
    },
    "whenToUse": [
      {
        "en": "Signalling an unknown wait that is expected to last longer than about one second."
      },
      {
        "en": "Fetching or refreshing search results, signing in, downloads, or loading large content such as videos."
      }
    ],
    "dos": [
      {
        "en": "Use a loader when the expected wait is not exactly known but is likely to take more than one second."
      }
    ],
    "donts": [
      {
        "en": "Do not show a loading indicator when the expected wait is less than one second."
      },
      {
        "en": "Do not use several loaders at the same time."
      }
    ],
    "similar": [
      {
        "id": "progress"
      }
    ]
  },
