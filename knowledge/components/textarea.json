      }
    ],
    "dos": [
      {
        "en": "Allow the copy and paste function."
      },
      {
        "en": "Let users enlarge the field when long text entries are expected."
      }
    ],
    "donts": [
      {
        "en": "Avoid the disabled state, because it limits accessibility."
      }
