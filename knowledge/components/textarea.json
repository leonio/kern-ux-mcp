  "docs": {
    "url": "https://www.kern-ux.de/komponenten/form-inputs/textarea",
    "summary": {
      "en": "Textarea lets users enter long, multi-line text. Its height can be set freely but is always greater than a single-line field, and its width can be adapted; users can resize it by dragging the bottom-right corner, and a vertical scrollbar appears once the content exceeds the height. The label should be short and precise, and a hint can explain format, meaning or background. Errors appear below the field, and all Input states apply."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/textarea#kurzbeschreibung",
        "summary": {
          "en": "Lets users enter long text content."
        }
      },
      {
        "id": "disabled",
        "heading": "Disabled",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/textarea#disabled",
        "summary": {
          "en": "Avoid the disabled state, because it limits accessibility."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/textarea#beschreibung",
        "summary": {
          "en": "A field for multi-line text. Its height can be set freely but is always larger than a single-line input. Users can resize it by dragging the bottom-right corner, and a scrollbar appears when the text outgrows the height. Errors appear below the field."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/textarea#verwendungsregeln",
        "summary": {
          "en": "Use Textarea only when users must enter multi-line text or paragraphs; otherwise use Input Text, and set the height in proportion to the expected text. Open questions are often hard, so check whether a complex question can be split into simple answers, such as radios."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/textarea#dos-und-donts",
        "summary": {
          "en": "Allow copy and paste, and let users enlarge the field when long text entries are expected. See also the general Dos and Don'ts for Input."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Multi-line text input; use it only for paragraphs, otherwise use Input Text."
    },
    "whenToUse": [
