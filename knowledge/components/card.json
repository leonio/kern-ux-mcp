  "docs": {
    "url": "https://www.kern-ux.de/komponenten/card",
    "summary": {
      "en": "Card presents related content compactly in a visually separated area built from Media, Header, Body and Footer. The page covers what each region holds, the three sizes and the fully interactive variant, grid placement, and rules for a clear focus, consistent sizing, reduced content and sparing use of actions."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/card#kurzbeschreibung",
        "summary": {
          "en": "Presents compact, related content in a visually separated area."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/card#beschreibung",
        "summary": {
          "en": "A card presents one content unit in a distinct area with four regions: Media holds the image, Header can add Preline and Subline, Body takes your own or KERN components such as Description List, and Footer holds one or two buttons. Cards fit a grid, may be fully interactive, and come in three sizes."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/card#verwendungsregeln",
        "summary": {
          "en": "Use cards to structure content semantically. Give each card one clear focus and a single information or task unit, using visual hierarchy. Keep cards in one context at the same size, structure and spacing, including media, avoid overload and use interactive elements sparingly."
        }
      },
      {
        "id": "dos-and-donts",
        "heading": "Dos and Don’ts",
        "url": "https://www.kern-ux.de/komponenten/card#dos-and-donts",
        "summary": {
          "en": "Do not use cards for long texts or complex tables. Do not mix card sizes in one context or overload a card with actions. Avoid redundant content across cards, and use at most one media item per card."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Presents one related content unit in a distinct area with Media, Header, Body and Footer regions."
    },
    "whenToUse": [
      {
        "en": "When related content such as image, text and actions should be shown compactly in one separated area."
      }
    ],
    "dos": [
      {
        "en": "Give each card one clear focus and only one connected information unit or task."
      },
      {
        "en": "Keep all cards in a context at the same size, structure and spacing."
      }
    ],
    "donts": [
      {
        "en": "Do not use cards for long texts or complex tables."
      },
      {
        "en": "Do not use different card sizes in the same context."
      },
      {
        "en": "Do not overload the card with too many actions or buttons."
      },
      {
        "en": "Do not use redundant information across several cards."
      },
      {
        "en": "Do not use more than one media item in a card."
      }
    ],
    "similar": [
      {
        "id": "dialog"
      }
    ]
  },
