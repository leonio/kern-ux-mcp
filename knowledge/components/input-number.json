  "docs": {
    "url": "https://www.kern-ux.de/komponenten/form-inputs/number",
    "summary": {
      "en": "Input Number takes a number. The field uses inputmode=\"numeric\", so mobile users get a numeric keypad, and it validates the entry and shows errors below the field. The label should make clear that only digits belong here; otherwise the hint must list the characters that are allowed. The width can be adjusted."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/number#kurzbeschreibung",
        "summary": {
          "en": "Input Number helps users enter a number."
        }
      },
      {
        "id": "disabled",
        "heading": "Disabled",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/number#disabled",
        "summary": {
          "en": "Avoid disabled, because it restricts accessibility."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/number#beschreibung",
        "summary": {
          "en": "The general input properties apply. inputmode=\"numeric\" gives users a numeric keypad, typically on mobile devices. Keep the label short and clear, optionally marked as optional, and use the hint for the format. Validation reports problems below the field, and the width can be adjusted."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/number#verwendungsregeln",
        "summary": {
          "en": "Used where the expected number cannot be predicted. If the answer options are known, prefer Select, Checkboxes or Radios; for a phone number or a date use Input Tel or Input Date. The label must show that only numbers are allowed, otherwise the hint must list the permitted characters."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/number#dos-und-donts",
        "summary": {
          "en": "For other fixed number formats, such as phone numbers or dates, use Input Tel or Input Date; when the options are known, use Select, Checkboxes or Radios. The general Input Dos and Don'ts also apply."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Input Number accepts a number through inputmode=\"numeric\" and reports validation errors below the field."
    },
    "whenToUse": [
      {
        "en": "Use Input Number for unpredictable numeric values such as a postcode, a house number or an area size."
      }
    ],
    "dos": [
      {
        "en": "Make the label show that only numbers are expected, for example a house number or a postcode."
      },
      {
        "en": "Explain the permitted characters in the hint when the label does not make it obvious."
      },
      {
        "en": "Use inputmode=\"numeric\" so users get a numeric keypad."
      }
    ],
    "donts": [
      {
        "en": "Don't use Input Number when the answer options are known; use Select, Checkboxes or Radios."
      },
      {
        "en": "Don't use it for a phone number or a date; Input Tel and Input Date fit better."
      },
      {
        "en": "Don't use disabled, because it restricts accessibility."
      }
    ],
