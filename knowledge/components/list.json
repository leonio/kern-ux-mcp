  "docs": {
    "url": "https://www.kern-ux.de/komponenten/text/list",
    "summary": {
      "en": "List structures related content into ordered, unordered or description lists, which makes the content easier to scan and compare. It offers the marker styles none, bullet and number, three sizes, and a horizontal layout. The usage rules and Dos and Don'ts for the component are not published yet."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/text/list#kurzbeschreibung",
        "summary": {
          "en": "Lists structure related content into ordered, unordered or description lists for better readability and clarity."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/text/list#beschreibung",
        "summary": {
          "en": "Lists are a fundamental element for structuring content; they present related information clearly and improve readability."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/text/list#verwendungsregeln",
        "summary": {
          "en": "The usage rules for List are not published in the documentation yet; the section is a placeholder."
        }
      },
      {
        "id": "dos-and-donts",
        "heading": "Do's and Don'ts",
        "url": "https://www.kern-ux.de/komponenten/text/list#dos-and-donts",
        "summary": {
          "en": "The Dos and Don'ts for List are not published in the documentation yet; the section is a placeholder."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "List groups related items as a bulleted, numbered or plain list, in three sizes or a horizontal layout."
    },
    "similar": [
