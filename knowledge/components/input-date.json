  "docs": {
    "url": "https://www.kern-ux.de/komponenten/form-inputs/date",
    "summary": {
      "en": "Input Date helps users enter a date. It splits the value into separate day, month and year fields, grouped and labelled as one unit with a hint that shows the order, for example 14 4 2014. Keep the field sizes as delivered, and choose examples that make the day and month order unambiguous."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/date#kurzbeschreibung",
        "summary": {
          "en": "Input Date helps users enter a date."
        }
      },
      {
        "id": "disabled",
        "heading": "Disabled",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/date#disabled",
        "summary": {
          "en": "Avoid disabled, because it restricts accessibility."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/date#beschreibung",
        "summary": {
          "en": "The general input properties apply. Three separate fields take day, month and year, grouped under one shared label, with a hint below giving the format, for example 14 4 2014. The fields read as one unit, and their size should stay unchanged so the layout stays stable."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/date#verwendungsregeln",
        "summary": {
          "en": "Used in forms to enter a date; the design follows the kind of date, for example a birth date or an expiry date copied from a document, whose format the fields should mirror. Choose examples that make the day and month order obvious, like 14 4 2014. Leading zeros are not required."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/date#dos-und-donts",
        "summary": {
          "en": "The general Input Dos and Don'ts apply, plus keeping the day, month and year fields at their default size so the layout stays stable."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Input Date splits a date into day, month and year fields, grouped under one label that states the expected order."
    },
    "whenToUse": [
      {
        "en": "Use Input Date when a form needs a date, such as a birth date or the expiry date of a document."
      }
    ],
    "dos": [
      {
        "en": "Give the group a clear shared label and a hint that states the format."
      },
      {
        "en": "Use examples such as 14 4 2014 so the day and month order is unambiguous."
      },
      {
        "en": "Mirror the source document's format when the date is copied from a passport or a card."
      },
      {
        "en": "Keep the three fields at their default size."
      }
    ],
    "donts": [
      {
        "en": "Don't use disabled, because it restricts accessibility."
      },
      {
        "en": "Don't require leading zeros."
      },
      {
        "en": "Don't change the size of the day, month and year fields."
      }
    ],
