  "docs": {
    "url": "https://www.kern-ux.de/komponenten/alert",
    "summary": {
      "en": "Alert flags important information or a change with a short notice. It has a header with an icon and descriptive title, an optional body text and an optional link, and four fixed colour-coded tones: info (blue), success (green), warning (yellow) and danger (red). The page explains effective use, the meaning of each tone and when not to use an alert."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/alert#kurzbeschreibung",
        "summary": {
          "en": "An alert flags important information with a short explanation and an optional link."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/alert#beschreibung",
        "summary": {
          "en": "An alert has a header of icon plus descriptive title and an optional content area with a short text and an optional link to more information or related actions. Four fixed tones: info (blue), success (green), warning (yellow), danger (red)."
        }
      },
      {
        "id": "effektiver-einsatz",
        "heading": "Effektiver Einsatz",
        "url": "https://www.kern-ux.de/komponenten/alert#effektiver-einsatz",
        "summary": {
          "en": "Keep the message clear and unambiguous, show alerts only when they are relevant for the user, communicate urgency appropriately, and let users react to the message directly."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/alert#verwendungsregeln",
        "summary": {
          "en": "Info (blue) for uncritical status without action; success (green) for a completed action; warning (yellow) for attention without criticality, stating whether an action is required; danger (red) for a critical state that blocks progress, naming or linking the needed action."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/alert#dos-und-donts",
        "summary": {
          "en": "Use alerts sparingly - a plain text paragraph can carry the information. Describe the reason briefly and precisely, name or link any required user action, and never leave users alone with a message without solutions."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Shows a short, colour-coded notice about important information, with optional description and link."
    },
    "whenToUse": [
      {
        "en": "When important information or a change must reach the user and a short notice with an optional link is enough."
      }
    ],
    "dos": [
      {
        "en": "Use alerts sparingly; information can also be conveyed in a paragraph of text."
      },
      {
        "en": "Describe the reason for the alert in a brief and precise explanation."
      },
      {
        "en": "If user action is required, name and/or link that action."
      }
    ],
    "donts": [
      {
        "en": "Do not leave users alone with a message; point out solutions."
      }
    ],
    "similar": [
      {
        "id": "badge"
      }
    ]
  },
