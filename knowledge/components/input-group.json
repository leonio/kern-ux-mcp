  "docs": {
    "url": "https://www.kern-ux.de/komponenten/form-inputs/input-group",
    "summary": {
      "en": "Input Group adds a prefix, suffix or action to a single field, for example a unit, a currency or a button. These parts are not part of the value and assistive technology does not read them, so the label or supporting text must carry their meaning. Focus and validation behave as for one input, with errors below the group."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/input-group#kurzbeschreibung",
        "summary": {
          "en": "An Input Group extends a field with a prefix, a suffix or an action to make the expected value clearer or to process it directly."
        }
      },
      {
        "id": "disabled",
        "heading": "Disabled",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/input-group#disabled",
        "summary": {
          "en": "Avoid disabled, because it restricts accessibility."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/input-group#beschreibung",
        "summary": {
          "en": "The general input properties apply. Text or interactive parts sit before or after the field and clarify the context; they are not part of the value. Focus and validation apply to the input, and errors appear below the group. The label must carry the meaning for assistive technology."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/input-group#verwendungsregeln",
        "summary": {
          "en": "Use Input Groups deliberately and for the context in hand: for units such as euro, percent or kilogram, for URL prefixes, or for an action tied to the entry, such as showing and hiding a password. They suit standardised input where part of the value is fixed."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/input-group#dos-und-donts",
        "summary": {
          "en": "Write the label so the context is clear, for example costs in euro rather than just costs, and keep it outside the group. Still handle values with a manually typed prefix. Skip the group when the field is self-explanatory, prefer signs such as %, and use prefixes sparingly."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Input Group adds a visual prefix, suffix or action to one field; it is not part of the value and must be explained in the label."
    },
    "whenToUse": [
      {
        "en": "Use Input Group when a fixed part of the value, a unit or a related action should sit directly on the field."
      },
      {
        "en": "Use it for standardised entries, such as a URL prefix, where part of the value is already given."
      }
    ],
    "dos": [
      {
        "en": "Write the label so the context is unambiguous, for example costs in euro."
      },
      {
        "en": "Keep the label outside the input group."
      },
      {
        "en": "Use universally understood prefixes and suffixes such as %."
      },
      {
        "en": "Still process values that contain a manually typed prefix or suffix."
      }
    ],
    "donts": [
      {
        "en": "Don't use an input group when the field is self-explanatory."
      },
      {
        "en": "Don't use ambiguous abbreviations or long, complex prefix and suffix content."
      },
      {
        "en": "Don't let prefixes and suffixes distract from the actual input."
      },
      {
        "en": "Don't use disabled, because it restricts accessibility."
      }
    ],
