  "docs": {
    "url": "https://www.kern-ux.de/komponenten/form-inputs/radios",
    "summary": {
      "en": "Radios let users pick exactly one option from a set of mutually exclusive options. A radio group always has a label making clear what the choice refers to, and it can be marked optional; each radio is labelled as briefly as possible. A hint can add detail, help can be offered for longer explanations, and error messages are shown below the group. All Input states apply except readonly. Two options sit horizontally, more stack vertically. Preselect only for settings, not for a question."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/radios#kurzbeschreibung",
        "summary": {
          "en": "Let users pick only one option from mutually exclusive options."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/radios#beschreibung",
        "summary": {
          "en": "A radio group lets users choose which option applies, always one and never several. The group always has a label, individual radios are labelled as briefly as possible, a hint or help can add detail, error messages appear below the group, and all Input states apply except readonly."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/radios#verwendungsregeln",
        "summary": {
          "en": "Use radios in forms when users must choose one of several options, for example how they want to identify themselves. Two radios are shown horizontally; more than two stack vertically. Preselect an option only for settings; when the choice answers a question, none should be selected up front."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/radios#dos-und-donts",
        "summary": {
          "en": "Never allow more than one option of a radio group to be selected. Write a radio label as a statement rather than a question where possible, and keep it short so it is easy to take in."
        }
      },
      {
        "id": "weitere-hinweise",
        "heading": "Weitere Hinweise",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/radios#weitere-hinweise",
        "summary": {
          "en": "Phrase a radio label positively where possible, avoiding constructions such as '... not ...' or '... no ...'."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Lets users select exactly one option from a mutually exclusive group."
    },
    "whenToUse": [
      {
        "en": "Forms where users must choose exactly one of several mutually exclusive options."
      }
    ],
    "dos": [
      {
        "en": "Write each radio label as a statement rather than a question where possible."
      },
      {
        "en": "Keep radio labels short so they can be grasped quickly."
      },
      {
        "en": "Phrase radio labels positively where possible, avoiding '... not ...' or '... no ...'."
      },
      {
        "en": "Preselect an option only for settings; when the choice answers a question, leave all options unselected."
      }
    ],
    "donts": [
      {
        "en": "Never allow more than one option of a radio group to be selected."
      },
      {
        "en": "Do not use the readonly state; radios accept all other Input states."
      }
    ],
    "similar": [
      {
        "id": "checkboxes"
      }
    ]
  },
