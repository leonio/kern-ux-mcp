  "docs": {
    "url": "https://www.kern-ux.de/komponenten/dialog",
    "summary": {
      "en": "Dialog communicates with users, delivers important information and asks for input, confirmation or a decision. The page covers modal and non-modal behaviour, the title, description and button rules, when dialogs are justified, the four use cases, and the JavaScript, form and autofocus implementation details."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/dialog#kurzbeschreibung",
        "summary": {
          "en": "A dialog communicates with users, conveys important information and asks for input, confirmation or a decision through interaction."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/dialog#beschreibung",
        "summary": {
          "en": "A dialog appears, overlays the main content and requires deliberate action. It is modal (focus trapped) or non-modal, with title and description. Offer a primary and a secondary button; one secondary suffices to confirm, and a third tertiary button stays exceptional. An \"X\" closes it."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/dialog#verwendungsregeln",
        "summary": {
          "en": "Use a dialog only for immediate decisions or input, and sparingly - prefer inline components or tooltips. Keep title and content short; long forms belong on separate pages. Always offer a deliberate close via \"X\" or Escape; critical dialogs must not close on overlay click."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/dialog#dos-und-donts",
        "summary": {
          "en": "Use non-modal dialogs for supporting information that does not disturb the workflow, ensure users can always deliberately close the dialog, and state its purpose with clear headings and specific button labels such as \"Speichern\" or \"Abbrechen\". Avoid sticky elements and keep content short."
        }
      },
      {
        "id": "dialog-mit-javascript-öffnen",
        "heading": "Dialog mit Javascript öffnen",
        "url": "https://www.kern-ux.de/komponenten/dialog#dialog-mit-javascript-öffnen",
        "summary": {
          "en": "A dialog can be opened by a button, using data attributes (data-dialog-target) to link buttons to their dialogs."
        }
      },
      {
        "id": "hmtl",
        "heading": "HMTL",
        "url": "https://www.kern-ux.de/komponenten/dialog#hmtl",
        "summary": {
          "en": "HTML example markup for opening a dialog."
        }
      },
      {
        "id": "javascript",
        "heading": "JavaScript",
        "url": "https://www.kern-ux.de/komponenten/dialog#javascript",
        "summary": {
          "en": "JavaScript example that connects data-dialog-target buttons to showModal(), closes the dialog on background clicks and handles a submit button."
        }
      },
      {
        "id": "verhalten",
        "heading": "Verhalten",
        "url": "https://www.kern-ux.de/komponenten/dialog#verhalten",
        "summary": {
          "en": "The button carrying data-dialog-target opens its dialog. The dialog closes through the close button or a click on the background."
        }
      },
      {
        "id": "1-einsatz-des-form-elements-im-dialog",
        "heading": "1. Einsatz des <form>-Elements im Dialog",
        "url": "https://www.kern-ux.de/komponenten/dialog#1-einsatz-des-form-elements-im-dialog",
        "summary": {
          "en": "The form element structures dialog interactions and enables native browser behaviour such as closing through buttons with formmethod=\"dialog\", and simplifies confirmation or cancel actions."
        }
      },
      {
        "id": "2-verwendung-des-autofocus-attributs",
        "heading": "2. Verwendung des autofocus-Attributs",
        "url": "https://www.kern-ux.de/komponenten/dialog#2-verwendung-des-autofocus-attributs",
        "summary": {
          "en": "autofocus focuses a specific input or button automatically when the dialog opens, improving usability - for example placing the cursor in a field or highlighting the primary button - without extra JavaScript."
        }
      },
      {
        "id": "3-browser-unterstützung",
        "heading": "3. Browser-Unterstützung",
        "url": "https://www.kern-ux.de/komponenten/dialog#3-browser-unterstützung",
        "summary": {
          "en": "Modern browsers support the dialog element, formmethod=\"dialog\" and autofocus; consider a polyfill for older browsers and check MDN for compatibility."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Modal or non-modal overlay that delivers information and asks for input, confirmation or a decision."
    },
    "whenToUse": [
      {
        "en": "Only when immediate decisions or input are needed, and only for important, time-critical or irreversible actions."
      }
    ],
    "dos": [
      {
        "en": "Use non-modal dialogs for supporting information that does not disturb the workflow."
      },
      {
        "en": "Make sure users can always perform a deliberate action to close the dialog."
      },
      {
        "en": "Communicate the dialog's purpose with clear headings and specific button labels such as \"Speichern\" or \"Abbrechen\"."
      },
      {
        "en": "Make confirmation, input and danger dialogs modal; information dialogs can be non-modal."
      }
    ],
    "donts": [
      {
        "en": "Do not use sticky elements such as headers or footers; they overlap content when zoomed."
      },
      {
        "en": "Do not let a dialog's content grow long; scrolling should be the exception."
      },
      {
        "en": "Do not close a critical dialog on an overlay click."
      }
    ],
    "similar": [
      {
        "id": "alert"
      },
      {
        "id": "accordion"
      }
    ]
  },
