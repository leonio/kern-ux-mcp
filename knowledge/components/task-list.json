  "docs": {
    "url": "https://www.kern-ux.de/komponenten/tasklist",
    "summary": {
      "en": "Task List shows the tasks users must complete and marks each one's status. It has a heading and one or more Task List elements; a group of at least two lists is often useful, especially when a summary follows. Each element describes a task, links to its form and can carry numbering and status: new, incomplete, done or not yet editable."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/tasklist#kurzbeschreibung",
        "summary": {
          "en": "Shows all tasks users must complete and marks the status of each task."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/tasklist#beschreibung",
        "summary": {
          "en": "A Task List has a heading and one or more Task List elements; a group of at least two lists is often useful, especially when a summary follows. Each element describes a task, links to its form and can carry numbering and status: new, incomplete, done or not yet editable."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/tasklist#verwendungsregeln",
        "summary": {
          "en": "Use a Task List or group for longer processes such as online services, where users work through tasks over several steps, placed on its own page that is easy to reach. It suits information too extensive for one page, processes needing several sessions, and tasks in any order."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/tasklist#dos-und-donts",
        "summary": {
          "en": "Keep to at most 7 tasks per Task List and keep the number of groups manageable. Write group and task labels short and clear for screen reader users. Communicate only the correct status, do not add other actions inside the Task List, and number tasks across the whole list."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Lists tasks with their completion status for longer, multi-step processes."
    },
    "whenToUse": [
      {
        "en": "Longer processes spread over several steps, such as online services."
      },
      {
        "en": "When the required information does not fit on one page or several sessions are needed."
      },
      {
        "en": "When tasks can be completed in any order."
      }
    ],
    "dos": [
      {
        "en": "Keep a Task List to at most 7 tasks."
      },
      {
        "en": "Keep the number of groups in a Task List group manageable."
      },
      {
        "en": "Write group and task labels short and clear so screen reader users can operate the list."
      },
      {
        "en": "Communicate only the correct status of a task."
      },
      {
        "en": "Number tasks across the whole list instead of restarting numbering per group."
      }
    ],
    "donts": [
      {
        "en": "Do not invent additional statuses beyond the ones defined."
      },
      {
        "en": "Do not add other buttons or actions inside the Task List."
      }
    ],
    "similar": [
      {
        "id": "summary"
      }
    ]
  },
