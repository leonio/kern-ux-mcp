  "docs": {
    "url": "https://www.kern-ux.de/komponenten/link",
    "summary": {
      "en": "A Link is a direct connection to other content. It is set apart from body text by colour and changes colour once visited, and different targets are marked with icons: internal, back, download, external, email, sign language and easy language. Links inside running text carry no icon; outside text an icon helps highlight the target. Use text, never an icon alone."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/link#kurzbeschreibung",
        "summary": {
          "en": "A Link is a direct connection to other content."
        }
      },
      {
        "id": "link-als-button-darstellen",
        "heading": "Link als Button darstellen",
        "url": "https://www.kern-ux.de/komponenten/link#link-als-button-darstellen",
        "summary": {
          "en": "The class kern-btn makes a link look like a button. This can help in forms or processes when navigating to another page or section is needed without changing data."
        }
      },
      {
        "id": "link-ohne-besuchten-zustand",
        "heading": "Link ohne besuchten Zustand",
        "url": "https://www.kern-ux.de/komponenten/link#link-ohne-besuchten-zustand",
        "summary": {
          "en": "The class kern-link--no-visited-state turns off the default visited state. Because that can make orientation harder, use it only in exceptional cases."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/link#beschreibung",
        "summary": {
          "en": "A link is an interactive element made of text, or an icon plus text, set apart from other text by colour. Once clicked it changes colour, so users can see which links they already followed. Inside running text links carry no icon; outside text an icon highlights the target."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/link#verwendungsregeln",
        "summary": {
          "en": "The icons mark the target: an arrow right for internal links, an arrow left for going back, a download arrow for documents, open-in-new for external pages, an envelope for email, plus symbols for sign language and easy-language content."
        }
      },
      {
        "id": "link-small",
        "heading": "Link small",
        "url": "https://www.kern-ux.de/komponenten/link#link-small",
        "summary": {
          "en": "The small variant suits areas where the link should carry less visual weight. Do not use it for primary navigation; the default Link is the better choice there."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/link#dos-und-donts",
        "summary": {
          "en": "Distinguish internal, external, email and download targets with different icons, and give different targets distinct link texts instead of one generic phrase. Add a second cue besides colour to text links, such as an underline or icon, and never use a link to change data or the URL as its text."
        }
      },
      {
        "id": "weitere-hinweise",
        "heading": "Weitere Hinweise",
        "url": "https://www.kern-ux.de/komponenten/link#weitere-hinweise",
        "summary": {
          "en": "Keep link text short but precise, and do not overload a page with links."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "A Link navigates to other content; mark different targets with icons and never use it to change data."
    },
    "whenToUse": [
      {
        "en": "Use a Link to navigate to another page, section, document or email address."
      },
      {
        "en": "Use the kern-btn class when a link should look like a button for navigation that changes no data."
      },
      {
        "en": "Use the small variant where a link should carry less visual weight, not for primary navigation."
      }
    ],
    "dos": [
      {
        "en": "Distinguish internal, external, email and download targets with different icons."
      },
      {
        "en": "Give different targets on one page distinct link texts instead of one generic phrase."
      },
      {
        "en": "Add a second cue besides colour, such as an underline or an icon."
      },
      {
        "en": "Always give a link visible text, even when an icon is present."
      },
      {
        "en": "Keep link text short but precise."
      }
    ],
    "donts": [
      {
        "en": "Don't use a link as a button for an action that changes data, for example in forms."
      },
      {
        "en": "Don't use the linked URL as the link text."
      },
      {
        "en": "Don't use an icon on its own without text."
      },
      {
        "en": "Don't overload the page with links."
      },
      {
        "en": "Don't remove the visited state except in exceptional cases."
      }
    ],
    "similar": [
