  "docs": {
    "url": "https://www.kern-ux.de/komponenten/form-inputs/url",
    "summary": {
      "en": "Input Url takes a web address through a type=\"url\" field and validates the format automatically. The label should make clear that only internet addresses belong here; if a particular format is expected, the hint must state the allowed characters. Errors appear below the field, and the width can be adjusted."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/url#kurzbeschreibung",
        "summary": {
          "en": "Input Url helps users enter an internet address (URL)."
        }
      },
      {
        "id": "disabled",
        "heading": "Disabled",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/url#disabled",
        "summary": {
          "en": "Avoid disabled, because it restricts accessibility."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/url#beschreibung",
        "summary": {
          "en": "The general input properties apply. The field uses input type=\"url\" for web addresses, allowing alphanumeric characters and the special characters a URL permits, and validates the format. Errors appear below the field, the width can be adjusted and all input states are supported."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/url#verwendungsregeln",
        "summary": {
          "en": "Input Url is used in forms to enter an internet address. The label should make clear that only addresses may be entered; if that is not obvious, or a particular format is expected, the hint must explain the allowed characters and the format."
        }
      },
      {
        "id": "dos-and-donts",
        "heading": "Dos and Don’ts",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/url#dos-and-donts",
        "summary": {
          "en": "Use Input Url only for internet addresses, and point users to the expected format. The general Input Dos and Don'ts also apply."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Input Url takes a web address in a type=\"url\" field and validates its format."
    },
    "whenToUse": [
      {
        "en": "Use Input Url when a form needs an internet address, for example the address of a service."
      }
    ],
    "dos": [
      {
        "en": "Use the field only for internet addresses."
      },
      {
        "en": "Point users to the expected format in the hint text."
      },
      {
        "en": "Make the label show that a web address is expected."
      }
    ],
    "donts": [
      {
        "en": "Don't use disabled, because it restricts accessibility."
      },
      {
        "en": "Don't leave the accepted format unstated; the label or hint must give it."
      }
    ],
    "similar": [
      {
        "id": "input-text"
      },
      {
        "id": "input-email"
      }
    ]
  },
