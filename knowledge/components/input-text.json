  "docs": {
    "url": "https://www.kern-ux.de/komponenten/form-inputs/text",
    "summary": {
      "en": "Input Text is the basic single-line field for alphanumeric input: letters, digits and special characters. It supports validation and shows an error message below the field, and its width can be adjusted. Use it when the expected entry cannot be predicted, not when the options are known or when the text is multi-line."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/text#kurzbeschreibung",
        "summary": {
          "en": "Input Text lets users enter letters, digits and special characters."
        }
      },
      {
        "id": "disabled",
        "heading": "Disabled",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/text#disabled",
        "summary": {
          "en": "Avoid disabled, because it restricts accessibility."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/text#beschreibung",
        "summary": {
          "en": "The general input properties apply. A text field is a basic component that takes alphanumeric data, letters, digits and special characters, and can be adapted for different input types. Validation reports problems below the field, the width can be adjusted and all input states are supported."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/text#verwendungsregeln",
        "summary": {
          "en": "Use Input Text when the expected entry is single-line and cannot be predicted. If the answer options are known and selectable, prefer Checkboxes or Radios, and for longer multi-line entries use Text Area."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/text#dos-und-donts",
        "summary": {
          "en": "When users choose from a predefined list, avoid free text: it is more error-prone and makes data harder to compare or match. Use Checkboxes or Radio buttons instead."
        }
      },
      {
        "id": "weitere-hinweise",
        "heading": "Weitere Hinweise",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/text#weitere-hinweise",
        "summary": {
          "en": "Refers to the general Dos and Don'ts for Input."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Input Text is the basic single-line field for alphanumeric input whose value cannot be predicted."
    },
    "whenToUse": [
      {
        "en": "Use Input Text for free-form, single-line entries such as a name, a street or a short note."
      }
    ],
    "dos": [
      {
        "en": "Use Input Text for single-line entries whose value cannot be predicted."
      },
      {
        "en": "Show the validation message below the field."
      }
    ],
    "donts": [
      {
        "en": "Don't use free text when users choose from a known list; use Checkboxes or Radios."
      },
      {
        "en": "Don't use Input Text for longer, multi-line input; use Text Area."
      },
      {
        "en": "Don't use disabled, because it restricts accessibility."
      }
    ],
