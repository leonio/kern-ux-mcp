  "docs": {
    "url": "https://www.kern-ux.de/komponenten/form-inputs/e-mail",
    "summary": {
      "en": "Input E-Mail takes a single email address and checks the format automatically, for example name@domain.tld, showing an error below the field when the entry is invalid. Use it only for email addresses, describe the expected format in the hint, and allow autocomplete so a previously typed address can be completed."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/e-mail#kurzbeschreibung",
        "summary": {
          "en": "Input E-Mail helps users enter an email address."
        }
      },
      {
        "id": "disabled",
        "heading": "Disabled",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/e-mail#disabled",
        "summary": {
          "en": "Avoid disabled, since it restricts accessibility."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/e-mail#beschreibung",
        "summary": {
          "en": "The general input properties apply. The field takes an email address and automatically checks that it follows the basic structure, for example username@domain.tld, and shows an error message for invalid input. It supports all the input states."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/e-mail#verwendungsregeln",
        "summary": {
          "en": "Use Input E-Mail only to enter email addresses, and give help with the expected format."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/e-mail#dos-und-donts",
        "summary": {
          "en": "Allow the autocomplete function so the email address is completed when the user has entered it before."
        }
      },
      {
        "id": "weitere-hinweise",
        "heading": "Weitere Hinweise",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/e-mail#weitere-hinweise",
        "summary": {
          "en": "Refers to the general Dos and Don'ts for Input."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Input E-Mail accepts one email address, validates its format and reports invalid entries below the field."
    },
    "whenToUse": [
      {
        "en": "Use Input E-Mail wherever a form needs an email address, for example registration or contact details."
      }
    ],
    "dos": [
      {
        "en": "Allow autocomplete so an address the user entered before can be completed."
      },
      {
        "en": "Explain the expected format in the hint text."
      }
    ],
    "donts": [
      {
        "en": "Don't use the field for anything other than email addresses."
      },
      {
        "en": "Don't use disabled, because it restricts accessibility."
      }
    ],
    "similar": [
      {
