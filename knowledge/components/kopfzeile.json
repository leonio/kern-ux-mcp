        "summary": {
          "en": "Shows the default markup of the Kopfzeile."
        }
      },
      {
        "id": "mit-eigenem-label-z-b-für-mandanten",
        "heading": "Mit eigenem Label (z. B. für Mandanten):",
        "url": "https://www.kern-ux.de/komponenten/kopfzeile#mit-eigenem-label-z-b-für-mandanten",
        "summary": {
          "en": "Shows the markup with a custom label, for example for a tenant."
        }
      },
      {
        "id": "mit-benutzerdefinierten-breakpoints",
        "heading": "Mit benutzerdefinierten Breakpoints:",
        "url": "https://www.kern-ux.de/komponenten/kopfzeile#mit-benutzerdefinierten-breakpoints",
        "summary": {
          "en": "Shows the markup with custom breakpoints."
        }
      },
      {
        "id": "mit-explizitem-theme",
        "heading": "Mit explizitem Theme:",
        "url": "https://www.kern-ux.de/komponenten/kopfzeile#mit-explizitem-theme",
        "summary": {
          "en": "Shows the markup with an explicitly set light or dark theme; by default the theme follows the user's system setting (prefers-color-scheme)."
        }
      },
      {
        "id": "inhalt-children",
        "heading": "Inhalt (Children)",
        "url": "https://www.kern-ux.de/komponenten/kopfzeile#inhalt-children",
        "summary": {
          "en": "The content between the tags can be a custom label; the default is the standard official wording."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/kopfzeile#beschreibung",
        "summary": {
          "en": "One of four elements of the digital umbrella brand, used voluntarily. The narrow top banner is a trust anchor: the German flag with the official wording to its right, on a full-width coloured background. The container variant aligns content left with the page grid, at most 1536 pixels wide."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/kopfzeile#verwendungsregeln",
        "summary": {
          "en": "Used on digital presences of authorities, online services and service portals; the placement at the very top lets users identify an official government offer immediately."
        }
      },
      {
        "id": "nutzen-der-kopfzeile",
        "heading": "Nutzen der Kopfzeile",
        "url": "https://www.kern-ux.de/komponenten/kopfzeile#nutzen-der-kopfzeile",
        "summary": {
          "en": "Three benefits: quick recognition, simple and inexpensive implementation, and a trust anchor."
        }
      },
      {
        "id": "beispiele",
        "heading": "Beispiele",
        "url": "https://www.kern-ux.de/komponenten/kopfzeile#beispiele",
        "summary": {
          "en": "Lists examples: Service Justiz, GOVDATA, the national feedback component and the Bundesportal."
        }
      },
      {
        "id": "dos-and-donts",
        "heading": "Dos and Don’ts",
        "url": "https://www.kern-ux.de/komponenten/kopfzeile#dos-and-donts",
        "summary": {
          "en": "Only public bodies may use it, aligned left with the main content area, usually done manually in code. Nothing may change in size, colour, font, content or position, and it belongs at the very top, never between content blocks or at the bottom. It scrolls with the content and is never sticky."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Kopfzeile is the fixed top banner that marks a public administration site; none of its parts may be changed."
    },
    "whenToUse": [
      {
        "en": "Use it on authorities' sites, online services and service portals to identify an official government offer."
      },
      {
        "en": "Use it to make an offer recognisable and trustworthy; using the umbrella brand elements is voluntary."
      }
    ],
    "dos": [
      {
        "en": "Use the Kopfzeile only for digital presences of public bodies."
      },
      {
        "en": "Place it at the very top and let it scroll with the content."
      },
      {
        "en": "Align its content left with the main content area, usually done manually in code."
      },
      {
        "en": "Leave size, colour, font, content and position exactly as delivered."
      },
      {
        "en": "Use the container variant when the content should follow the page grid."
      }
    ],
    "donts": [
      {
        "en": "Don't change any part of the banner: size, colour, font, content or position."
      },
      {
        "en": "Don't place it between content blocks or at the bottom of the page."
      },
      {
        "en": "Don't make the banner sticky."
      },
      {
        "en": "Don't publish a custom design without agreement from the umbrella brand coordination group."
      }
    ]
  },
