      },
      {
        "id": "webkomponente",
        "heading": "Webkomponente",
        "url": "https://www.kern-ux.de/komponenten/kopfzeile#webkomponente",
        "summary": {
          "en": "Most KERN components are plain HTML and CSS for flexibility; the Kopfzeile is also shipped as a web component so it stays consistent and can be updated centrally instead of editing every page."
        }
      },
