  "docs": {
    "url": "https://www.kern-ux.de/komponenten/kopfzeile",
    "summary": {
      "en": "The Kopfzeile is one of the four elements of the digital umbrella brand and marks a website as an official public administration presence. It is a narrow coloured banner at the very top, with the German flag and the official wording beside it. Its parts are tested and must not be changed; it scrolls with the page and is never sticky."
    },
    "sections": [
