  "docs": {
    "url": "https://www.kern-ux.de/komponenten/button",
    "summary": {
      "en": "Button triggers an action and its label names it. The page sets the 48 px default size and 8 px scale, describes the five sizes and the larger functional hit area of x-small and small, the primary, secondary and tertiary importance levels, icon use, when to avoid inactive buttons, the mobile block button, and label and placement rules."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/button#kurzbeschreibung",
        "summary": {
          "en": "A button triggers an action; its label names that action."
        }
      },
      {
        "id": "button-dimensionen",
        "heading": "Button-Dimensionen",
        "url": "https://www.kern-ux.de/komponenten/button#button-dimensionen",
        "summary": {
          "en": "The button system uses a 48 px default size; the other sizes scale in consistent 8 px steps."
        }
      },
      {
        "id": "größenübersicht",
        "heading": "Größenübersicht",
        "url": "https://www.kern-ux.de/komponenten/button#größenübersicht",
        "summary": {
          "en": "Sizes refer to the visual height. On x-small and small the functional click area extends beyond the visible surface, so the target stays large enough in compact or dense layouts."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/button#beschreibung",
        "summary": {
          "en": "A button lets users trigger an action, such as confirming, submitting information, changing data or moving to the next process step. It carries a label describing the action briefly and precisely, and may include icons for visual support."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/button#verwendungsregeln",
        "summary": {
          "en": "Three levels: primary triggers the page's main function and appears once per page; secondary supports it, e.g. cancel or back, and should stay rare; tertiary marks functions unrelated to the main one, such as sorting, while still reading as a control."
        }
      },
      {
        "id": "icons",
        "heading": "Icons",
        "url": "https://www.kern-ux.de/komponenten/button#icons",
        "summary": {
          "en": "Add icons only when they speed up understanding, e.g. a left arrow to go back, a bin to delete, a magnifier to search. The icon sits before the label by default, after it when that aids comprehension. Icon-only buttons need a familiar icon and an alt attribute."
        }
      },
      {
        "id": "inaktiv",
        "heading": "Inaktiv",
        "url": "https://www.kern-ux.de/komponenten/button#inaktiv",
        "summary": {
          "en": "Inactive buttons show that a function exists but is unavailable. Because of poor contrast and confusion with other buttons, avoid them if possible; use them only when they aid understanding, recognition or consistency."
        }
      },
      {
        "id": "block-button",
        "heading": "Block-Button",
        "url": "https://www.kern-ux.de/komponenten/button#block-button",
        "summary": {
          "en": "Use the block button in mobile views: its width follows the screen rather than the text length, which makes the layout clearer."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/button#dos-und-donts",
        "summary": {
          "en": "Use one primary button per page, mixed case instead of capitals, and place buttons side by side rather than stacked when there is room, highlighting the more important one. Avoid two-line labels and never put buttons inline in text; use text links."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Triggers an action, named by its label, in primary, secondary or tertiary importance; one primary per page."
    },
    "whenToUse": [
      {
        "en": "When the user triggers an action such as confirming, submitting, changing data or moving to the next step."
      }
    ],
    "dos": [
      {
        "en": "Use only one primary button per page."
      },
      {
        "en": "Use mixed case labels rather than all capitals."
      },
      {
        "en": "When buttons of different importance sit together, highlight the more important one."
      },
      {
        "en": "Place buttons side by side rather than stacked when space allows."
      }
    ],
    "donts": [
      {
        "en": "Avoid two-line or multi-line button labels."
      },
      {
        "en": "Do not use buttons inline in texts; use text links instead."
      },
      {
        "en": "Avoid inactive buttons where possible; their contrast is poor and they are easily confused with other buttons."
      }
    ],
    "similar": [
      {
        "id": "link"
      }
    ]
  },
