  "docs": {
    "url": "https://www.kern-ux.de/komponenten/icon",
    "summary": {
      "en": "Icons are the small symbols that mark actions, content and status. KERN draws them from Google Material Symbols in the rounded, filled style with weight 400, grade 0 and optical size 24, in four sizes. Use them sparingly, only where they add value, and keep one icon to one meaning."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/icon#kurzbeschreibung",
        "summary": {
          "en": "Icons are small graphic symbols that show or emphasise actions, content or status."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/icon#beschreibung",
        "summary": {
          "en": "KERN uses Google Material Symbols in the rounded style with the fill option and the typographic settings weight 400, grade 0 and optical size 24. The result is balanced and soft, and each icon can be used in one of four sizes."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/icon#verwendungsregeln",
        "summary": {
          "en": "Icons must be clear and intuitive and are best supported by text. Use them sparingly and only where they add value, for example to mark an action or a status. Give each icon a single function and keep it consistent across the interface: the magnifier means search and should not also mean zoom."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/icon#dos-und-donts",
        "summary": {
          "en": "Balance the icon size against the text beside it, avoid unclear icons, do not overload the interface with icons, prefer familiar symbols, and use one icon for one purpose only."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Icons are small Material Symbols that mark actions, content or status, used sparingly with one meaning per icon."
    },
    "whenToUse": [
      {
        "en": "Use an icon only where it adds value, for example to mark an action or a status."
      }
    ],
    "dos": [
      {
        "en": "Use Material Symbols in the rounded style with fill, weight 400, grade 0 and optical size 24."
      },
      {
        "en": "Match the icon size to the text next to it."
      },
      {
        "en": "Prefer familiar, learned symbols for an action or status."
      },
      {
        "en": "Use a given icon for exactly one purpose across the interface."
      }
    ],
    "donts": [
      {
        "en": "Don't use icons whose meaning is unclear or ambiguous."
      },
      {
        "en": "Don't overload the interface with icons."
      },
      {
        "en": "Don't reuse an established symbol, such as the magnifier for search, for a different function."
      }
    ]
  },
