  "docs": {
    "url": "https://www.kern-ux.de/komponenten/descriptionlist",
    "summary": {
      "en": "Description List pairs terms with their descriptions to give a clear, accessible information hierarchy, for example for form entries, technical specifications or glossaries. The page covers the row and column layouts and their responsive behaviour, when to use Accordion instead, and guidance on term length and list width."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/descriptionlist#kurzbeschreibung",
        "summary": {
          "en": "Structures the presentation of terms and their definitions."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/descriptionlist#beschreibung",
        "summary": {
          "en": "A Description List has a term and its description, giving a good overview and a clear, accessible information hierarchy. It suits summarising form entries, technical specifications or glossaries. On wide screens the term can sit left of or above the description; on mobile it always sits above."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/descriptionlist#verwendungsregeln",
        "summary": {
          "en": "With much content, terms and definitions can be stacked directly. Use the list when everything should be visible at once; otherwise use Accordion. Keep terms short and precise, choose the vertical variant for mostly long terms, and do not make the list too wide."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/descriptionlist#dos-und-donts",
        "summary": {
          "en": "Do not use a Description List for pure enumerations, and do not overload terms and descriptions with too much content."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Pairs short terms with their descriptions in a row or column layout for a clear information hierarchy."
    },
    "whenToUse": [
      {
        "en": "When terms and definitions need a clear, accessible information hierarchy."
      },
      {
        "en": "When all terms and definitions should be visible at a glance, e.g. summaries of form entries, specifications or glossaries."
      }
    ],
    "donts": [
      {
        "en": "Do not use a Description List for pure enumerations."
      },
      {
        "en": "Do not overload terms and descriptions with too much content."
      }
    ],
    "similar": [
      {
        "id": "accordion"
      }
    ]
  },
