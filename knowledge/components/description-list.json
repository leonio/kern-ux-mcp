      "html": {
        "markup": "<dl class=\"kern-description-list\"><div class=\"kern-description-list-item\"><dt class=\"kern-description-list-item__key\">Name</dt><dd class=\"kern-description-list-item__value\">Max</dd></div><div class=\"kern-description-list-item\"><dt class=\"kern-description-list-item__key\">Vorname</dt><dd class=\"kern-description-list-item__value\">Mustermann</dd></div><div class=\"kern-description-list-item\"><dt class=\"kern-description-list-item__key\">E-Mail</dt><dd class=\"kern-description-list-item__value\">dasisteinesehrlangeemailadressevonmaxmustermann@unternehmen.xy</dd></div><div class=\"kern-description-list-item\"><dt class=\"kern-description-list-item__key\">Sachkundigen vor Ort</dt><dd class=\"kern-description-list-item__value\"><ul><li>Berger Ernst</li><li>Müller, Hans</li><li>Sagmeister, Petra</li><li>Pan, Peter</li></ul></dd></div></dl>",
