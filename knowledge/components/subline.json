    "en": "Subline",
    "de": "Subline"
  },
  "status": "stable",
  "group": "text",
  "synonyms": {
    "de": [
      "Sekundärüberschrift",
      "Unterüberschrift",
      "Caption",
      "Subheading"
    ]
  },
  "links": {
    "docs": "https://www.kern-ux.de/komponenten/text/subline",
