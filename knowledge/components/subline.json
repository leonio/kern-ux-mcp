  },
  "docs": {
    "url": "https://www.kern-ux.de/komponenten/text/subline",
    "summary": {
      "en": "Subline adds short supporting information below a Title or Heading. It is a text component that gives the heading above it more context while staying visually and hierarchically in the background, and it is never used on its own. It comes in three sizes: large, default and small. Match the size to the heading or title above it and place the Subline directly below that heading with no extra spacing, since the vertical rhythm is already in the styles."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/text/subline#kurzbeschreibung",
        "summary": {
          "en": "Adds explanatory information below a Title or Heading."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/text/subline#beschreibung",
        "summary": {
          "en": "Usually a short explanatory text that deepens the context of the Heading or Title above it. It sits directly below that heading, stays visually and hierarchically in the background, and comes in three sizes: large, default and small."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/text/subline#verwendungsregeln",
        "summary": {
          "en": "Subline complements a Title or Heading visually and in content with extra information. It is never standalone and pairs closely with the heading above it; match its size to that heading and place it directly below with no extra spacing, since the styles already handle the vertical rhythm."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/text/subline#dos-und-donts",
        "summary": {
          "en": "Keep the text short and to the point, for example a context hint or a category. Do not use Subline as a standalone heading, for longer explanations or body copy, without a clear link to the statement above it, with extra bold or italic styling, with inconsistent sizes, or to structure the page."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Adds short supporting text below a Title or Heading; never used standalone."
    },
    "whenToUse": [
      {
        "en": "To add supporting context below a Title or Heading."
      }
    ],
    "dos": [
      {
        "en": "Keep the Subline text short and to the point, for example a context hint or a category label."
      }
    ],
    "donts": [
      {
        "en": "Do not use Subline as a standalone heading; it always supplements a Title or Heading."
      },
      {
        "en": "Do not use Subline for long explanations or running text; use the Body component."
      },
      {
        "en": "Do not use Subline without a clear link to the statement above it."
      },
      {
        "en": "Do not add bold, italic or other text formatting; the style already provides it."
      },
      {
        "en": "Do not combine Subline with a size that differs from the heading or title above it."
      },
      {
        "en": "Do not use Subline to structure the page; the Heading component is solely responsible for that."
      }
    ],
    "similar": [
