  "docs": {
    "url": "https://www.kern-ux.de/komponenten/search",
    "summary": {
      "en": "Search lets users find content and information quickly with a search term. It combines a search field and a search button and is built on the Input Group; some browsers add a native clear function. It comes in standard and block variants, several sizes and different button styles. Search is dynamic and iterative: users try several terms and refine them. Keep it in the same place throughout, with a global search expected top right, and never use a placeholder instead of a visible label."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/search#kurzbeschreibung",
        "summary": {
          "en": "Lets users find content and information, such as administrative services, quickly with a search term."
        }
      },
      {
        "id": "search-mit-label-und-icon-only-button",
        "heading": "Search mit Label und Icon-Only Button",
        "url": "https://www.kern-ux.de/komponenten/search#search-mit-label-und-icon-only-button",
        "summary": {
          "en": "If the search button uses only an icon, a label is mandatory for accessibility reasons."
        }
      },
      {
        "id": "search-ohne-label",
        "heading": "Search ohne Label",
        "url": "https://www.kern-ux.de/komponenten/search#search-ohne-label",
        "summary": {
          "en": "Use a search without a visible label only in justified exceptions, such as in the header. Otherwise the search needs a visible label, and without one its purpose must be named programmatically, for example via aria-label."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/search#beschreibung",
        "summary": {
          "en": "Search consists of a search field and a search button and is based on the Input Group, combining an input with an action that triggers the search. Some browsers add a native clear function. The component comes as a standard or block variant, with several sizes and different button styles."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/search#verwendungsregeln",
        "summary": {
          "en": "Use Search when users should target content or data. Unlike classic form input, it is dynamic and iterative, so keep its position consistent. Never use a placeholder instead of a visible label, and make the button primary only when search is the key action on the page."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don'ts",
        "url": "https://www.kern-ux.de/komponenten/search#dos-und-donts",
        "summary": {
          "en": "Place search consistently, make the term easy to reset, and keep the term in the field after submitting so users can refine it. Do not use placeholder text instead of a visible label, reduce search to a magnifier icon on desktop, or hide central search behind several steps on mobile."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Search field plus button, built on Input Group, for finding content with a search term."
    },
    "whenToUse": [
      {
        "en": "When users should search content, documents or data, such as administrative services."
      },
      {
        "en": "For dynamic, iterative lookups where users try and refine several search terms."
      }
    ],
    "dos": [
      {
        "en": "Place the search in the same position on every page."
      },
      {
        "en": "Make sure the search term can be reset via a clear function or the browser's native behaviour."
      },
      {
        "en": "Keep the search term in the field after submitting so users can refine it."
      },
      {
        "en": "Use the variant without a visible label only in justified exceptions, such as the header."
      },
      {
        "en": "If the search button shows only an icon, always provide a label for accessibility."
      }
    ],
    "donts": [
      {
        "en": "Do not use placeholder text instead of a visible label; placeholders disappear while typing."
      },
      {
        "en": "Do not reduce search to a magnifier icon on desktop when it is relevant to task success."
      },
      {
        "en": "Do not hide a central search behind several steps on mobile devices."
      }
    ],
    "similar": [
