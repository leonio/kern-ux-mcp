  "docs": {
    "url": "https://www.kern-ux.de/komponenten/table",
    "summary": {
      "en": "Table presents structured data in rows and columns for easy comparison and quick scanning. It comes in two sizes, default and small. A table can have an action column at the right edge with right-aligned buttons; those always use button size x-small and only the Secondary and Tertiary variants, never Primary, so the page hierarchy stays intact. Action-column buttons need a meaningful accessible name; when labels repeat or are icon-only, link them to the row header via aria-describedby."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/table#kurzbeschreibung",
        "summary": {
          "en": "Presents data in tabular form for easy comparison and quick scanning of information."
        }
      },
      {
        "id": "aktionen",
        "heading": "Aktionen",
        "url": "https://www.kern-ux.de/komponenten/table#aktionen",
        "summary": {
          "en": "Tables can have an action column at the right edge, with the buttons inside its cells aligned to the right."
        }
      },
      {
        "id": "buttons-in-tabellen",
        "heading": "Buttons in Tabellen",
        "url": "https://www.kern-ux.de/komponenten/table#buttons-in-tabellen",
        "summary": {
          "en": "Action-column interaction elements always use button size x-small. Only Secondary and Tertiary are allowed, never Primary. Buttons need an accessible name, linked to the row header via aria-describedby when labels repeat or are icon-only."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/table#beschreibung",
        "summary": {
          "en": "A table is a static, tabular structure with one or more rows and several columns; it is not interactive. Rows can be striped for readability. The component comes in two sizes: default and small."
        }
      },
      {
        "id": "bestandteile-einer-tabelle",
        "heading": "Bestandteile einer Tabelle:",
        "url": "https://www.kern-ux.de/komponenten/table#bestandteile-einer-tabelle",
        "summary": {
          "en": "Parts of a table: an optional Caption describing the content; the Head with column headings; the Body with the data rows, one record per row and one attribute per column; and an optional Footer below the body for totals or extra information."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/table#verwendungsregeln",
        "summary": {
          "en": "Use the table for structured data that fits in rows and columns, with clear column headings and content ordered for quick scanning; with very many columns, consider another presentation. Right-align numbers, left-align text, align dates by convention. Check small screens for horizontal scrolling."
        }
      },
      {
        "id": "dos",
        "heading": "Dos",
        "url": "https://www.kern-ux.de/komponenten/table#dos",
        "summary": {
          "en": "Do not use tables for unstructured content or to lay out a page; use the Grid for layout. Use visual emphasis such as bold for important data points, right-align values in numeric columns, do not overload the table with too many columns, and avoid unexplained abbreviations."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Presents structured data in rows and columns; static, with an optional action column."
    },
    "whenToUse": [
      {
        "en": "For structured data that can be arranged meaningfully in rows and columns."
      }
    ],
    "dos": [
      {
        "en": "Right-align values in columns that contain only numbers to make comparison easier."
      },
      {
        "en": "Use visual emphasis such as bold for important data points."
      },
      {
        "en": "Always use button size x-small for interaction elements in the action column."
      },
      {
        "en": "Give action-column buttons a meaningful accessible name, linking them to the row header via aria-describedby when labels repeat or are icon-only."
      }
    ],
    "donts": [
      {
        "en": "Do not use tables for unstructured content."
      },
      {
        "en": "Do not use tables to lay out page content; use the Grid instead."
      },
      {
        "en": "Do not overload a table with too many columns or too much data."
      },
      {
        "en": "Do not use unexplained abbreviations or symbols."
      },
      {
        "en": "Do not use Primary buttons inside a table; only Secondary and Tertiary are allowed."
      }
    ],
    "similar": [
      {
        "id": "description-list"
      },
      {
        "id": "summary"
      }
    ]
  },
