  "docs": {
    "url": "https://www.kern-ux.de/komponenten/summary",
    "summary": {
      "en": "Summary collects the information users entered in earlier forms and lets them edit it. It consists of a heading, a Description List and a link to edit, and several summaries form a summary group. The heading describes the preceding task, optionally numbered. Each Description List entry pairs the information asked for with the user's entry. Use it after users entered information via a Task List or Task List group, so they can review everything before continuing."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/summary#kurzbeschreibung",
        "summary": {
          "en": "Collects all information users entered in earlier forms, which they can edit if needed."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/summary#beschreibung",
        "summary": {
          "en": "A Summary has a heading, a Description List and a link to edit; several summaries form a summary group. The heading describes the preceding task, optionally with a number. Each Description List entry pairs the term (the information asked for) with the description (what the user entered)."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/summary#verwendungsregeln",
        "summary": {
          "en": "Use Summary or a summary group when users entered information via a Task List or Task List group, so they can review all entries before continuing; it is only complete once every entry is made. Showing part of the information is fine to avoid overload, but only when users need not check everything."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/summary#dos-und-donts",
        "summary": {
          "en": "Use the same wording as the related Task List or Task List group for the same tasks and groups. Do not hide essential information, so users know where to change entries, show the information in the order it was entered, and do not add other buttons or actions inside the Summary."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Shows earlier form entries as term and value pairs so users can review and edit them."
    },
    "whenToUse": [
      {
        "en": "After users entered information through a Task List or Task List group and need to review it before continuing."
      },
      {
        "en": "Before sending a form, so entries can be checked calmly."
      }
    ],
    "dos": [
      {
        "en": "Use the same wording for the same tasks and groups as in the related Task List or Task List group."
      },
      {
        "en": "Show the information in the same order in which it was entered."
      }
    ],
    "donts": [
      {
        "en": "Do not hide essential information; users must be able to see where to change their entries."
      },
      {
        "en": "Do not use other buttons or actions inside the Summary."
      }
    ],
    "similar": [
      {
        "id": "task-list"
      },
      {
        "id": "description-list"
      }
    ]
  },
