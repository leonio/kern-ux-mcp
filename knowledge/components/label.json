  },
  "docs": {
    "url": "https://www.kern-ux.de/komponenten/text/label",
    "summary": {
      "en": "Label is the short text that names an interactive element so users can tell what it does. It sits above its element, or to the right of a checkbox or radio, and comes in three sizes plus a subtle variant with a lighter weight. Keep it to a few clear words, style it only through the provided variants, and use Body for explanations."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/text/label#kurzbeschreibung",
        "summary": {
          "en": "A Label names interactive elements and makes their function clear."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/text/label#beschreibung",
        "summary": {
          "en": "A text component that names interactive elements so users can match fields, buttons and controls unambiguously. Keep it short and clear, placed above the element or, for checkboxes and radios, to its right. Sizes small, default and large exist, plus a subtle variant with a reduced type weight."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/text/label#verwendungsregeln",
        "summary": {
          "en": "Use label-default for inputs, selects and controls such as Select, Checkbox and Radio, or buttons. label-large suits prominent input areas or complex forms, label-small fits tight space so use it sparingly, and label-subtle lets labels recede while staying readable and clearly assigned."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/text/label#dos-und-donts",
        "summary": {
          "en": "Write labels clearly and precisely, for example an email address rather than a generic input. Label every interactive element, place it above by default and keep it short enough for one line. Use the provided variants instead of custom styles, and use Body for explanatory text or longer hints."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Label is the short text that names an input, button or control; it sits above the element."
    },
    "whenToUse": [
      {
        "en": "Use Label for inputs, selects, checkboxes, radios and buttons that need a name."
      },
      {
        "en": "Use label-large for particularly prominent input areas or complex form structures."
      },
      {
        "en": "Use label-subtle when a label should recede within the information hierarchy."
      }
    ],
    "dos": [
      {
        "en": "Write labels clearly and precisely, for example an email address rather than a generic input."
      },
      {
        "en": "Give every interactive element a label."
      },
      {
        "en": "Place the label above its element by default; inside works only for compact variants."
      },
      {
        "en": "Keep labels short enough to read on one line."
      },
      {
        "en": "Use the provided sizes and the subtle variant instead of custom styling."
      }
    ],
    "donts": [
      {
        "en": "Don't restyle labels by hand; use the provided variants."
      },
      {
        "en": "Don't use a label for explanatory text or longer hints; use Body instead."
      }
    ],
    "similar": [
      {
        "id": "body"
      }
    ]
  },
