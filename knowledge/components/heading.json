  },
  "docs": {
    "url": "https://www.kern-ux.de/komponenten/text/heading",
    "summary": {
      "en": "Headings label and structure a page and its sections. Mark each one with the matching HTML heading tag so browsers, search engines and assistive technology read the outline correctly, and add the KERN class for consistent styling. One h1 per page, a strict hierarchy underneath, short sentence-case wording."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/text/heading#kurzbeschreibung",
        "summary": {
          "en": "A Heading structures and describes content sections so that users and assistive technology can orient themselves quickly."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/text/heading#beschreibung",
        "summary": {
          "en": "Headings divide a page into clear sections and summarise the text below them. They are part of the semantic document structure, so correct markup is what lets content be captured, found and read accessibly."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/text/heading#verwendungsregeln",
        "summary": {
          "en": "Always mark headings with the proper HTML tag such as h1 or h2 to keep the page's semantic structure, and add a matching CSS class so they stay visually consistent. Use headings for the page and for every section."
        }
      },
      {
        "id": "übersicht-rolle-und-verwendung-von-überschriftenelementen",
        "heading": "Übersicht: Rolle und Verwendung von Überschriftenelementen",
        "url": "https://www.kern-ux.de/komponenten/text/heading#übersicht-rolle-und-verwendung-von-überschriftenelementen",
        "summary": {
          "en": "Explains the role of each element: the title tag sets the browser tab and search result title, h1 is the one visible main heading per page, h2 marks each top-level section, and h3 and h4 divide an h2 section further."
        }
      },
      {
        "id": "anwendung-der-visuellen-und-semantischen-hierarchie",
        "heading": "Anwendung der visuellen und semantischen Hierarchie",
        "url": "https://www.kern-ux.de/komponenten/text/heading#anwendung-der-visuellen-und-semantischen-hierarchie",
        "summary": {
          "en": "Pick the visual size from the number of hierarchy levels on the page, so the outline stays clear even on more complex pages."
        }
      },
      {
        "id": "seiten-mit-vier-und-mehr-ebenen",
        "heading": "Seiten mit vier und mehr Ebenen",
        "url": "https://www.kern-ux.de/komponenten/text/heading#seiten-mit-vier-und-mehr-ebenen",
        "summary": {
          "en": "On pages with four or more levels the usual visual hierarchy may be departed from in special cases, such as the Alert component. Make sure the page stays accessible, especially for screen reader users."
        }
      },
      {
        "id": "display-überschrift",
        "heading": "Display-Überschrift",
        "url": "https://www.kern-ux.de/komponenten/text/heading#display-überschrift",
        "summary": {
          "en": "Heading Display is a very large heading for standout statements, not for structuring content. Use it only in exceptions, for example a landing page opening line, a personal greeting or the framing of a special area. Mark it up semantically and check how it renders on small devices."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/text/heading#dos-und-donts",
        "summary": {
          "en": "One h1 per page, never fake a heading with bold text or font sizes because search engines and screen readers will not recognise it, no h3 or h4 before an h2, and write headings in regular sentence case rather than capitals."
        }
      },
      {
        "id": "weitere-hinweise",
        "heading": "Weitere Hinweise",
        "url": "https://www.kern-ux.de/komponenten/text/heading#weitere-hinweise",
        "summary": {
          "en": "Keep headings short, use them to structure the content, consider splitting very long pages into several, and avoid manually inserted line breaks inside a heading."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Headings label and structure a page and its sections; mark them up with h1-h6 and keep the outline in order."
    },
    "whenToUse": [
      {
        "en": "Use headings for the page title and for every section, so the page stays scannable for people and machines."
      },
      {
        "en": "Choose the visual size from the depth of the outline on the page."
      }
    ],
    "dos": [
      {
        "en": "Mark every heading with the matching HTML tag such as h1 or h2."
      },
      {
        "en": "Keep exactly one h1 per page."
      },
      {
        "en": "Keep the hierarchy in order: never place an h3 or h4 before an h2."
      },
      {
        "en": "Write headings in regular sentence case, not in capitals."
      },
      {
        "en": "Keep headings short and free of manual line breaks."
      },
      {
        "en": "Add the matching CSS class so headings stay visually consistent."
      }
    ],
    "donts": [
      {
        "en": "Don't build headings with manual bold or font-size formatting; search engines and screen readers will not recognise them."
      },
      {
        "en": "Don't use Heading Display to structure content; it is only for standout statements."
      }
    ],
