  "docs": {
    "url": "https://www.kern-ux.de/komponenten/form-inputs/select",
    "summary": {
      "en": "Select lets users choose one option from a drop-down list. Users open the list by clicking or focusing with the keyboard; the current value is highlighted in the open list and shown on the closed element, and text cannot be typed directly. The label should be short and precise, and a hint can explain the options. Errors appear below the field and the width can be adapted. All Input states apply except readonly. Use it for 5 to 15 options, never to trigger actions or as navigation."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/select#kurzbeschreibung",
        "summary": {
          "en": "Lets users choose one option from a drop-down list of options."
        }
      },
      {
        "id": "disabled",
        "heading": "Disabled",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/select#disabled",
        "summary": {
          "en": "Avoid the disabled state, because it limits accessibility."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/select#beschreibung",
        "summary": {
          "en": "Select allows exactly one option from a predefined list, opened by click or keyboard focus. The current value is highlighted in the open list and shown when closed, and free text cannot be entered. Errors appear below the field, and all Input states apply except readonly."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/select#verwendungsregeln",
        "summary": {
          "en": "Use a select to choose options in forms, not to reach actions or as navigation, with 5 to 15 options and one selectable value. Selects are hard to use, so prefer asking for information with Input Radios or Input Checkboxes; keep a select for tight space or to avoid input errors."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/select#dos-und-donts",
        "summary": {
          "en": "Keep the labels of the values in the list as short as possible."
        }
      },
      {
        "id": "weitere-hinweise",
        "heading": "Weitere Hinweise",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/select#weitere-hinweise",
        "summary": {
          "en": "Use at most 15 values in the list; more makes it hard to find the right option, so prefer radios where possible. Preselect a value only for a setting that is already active, otherwise the preselection can sway users or hide the need to choose."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Single-choice drop-down list; use it for 5 to 15 options and favour radios where possible."
    },
    "whenToUse": [
      {
        "en": "Forms where users pick exactly one of 5 to 15 predefined options."
      },
      {
        "en": "When space is tight or input errors must be avoided."
      }
    ],
    "dos": [
      {
        "en": "Keep the labels of the values in the list as short as possible."
      }
    ],
    "donts": [
      {
        "en": "Avoid the disabled state, because it limits accessibility."
      },
      {
        "en": "Do not use a select as a way to trigger actions or as navigation."
      },
      {
        "en": "Do not use more than 15 values in the selection list; the right option becomes hard to find."
      }
    ],
    "similar": [
      {
        "id": "radios"
      },
      {
        "id": "checkboxes"
      }
    ]
  },
