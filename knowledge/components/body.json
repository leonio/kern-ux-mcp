  "docs": {
    "url": "https://www.kern-ux.de/komponenten/text/body",
    "summary": {
      "en": "Body is the running-text component for longer information. The page defines its three sizes (small, default, large) plus the bold and muted styles, when large fits an entry page, small suits supplementary text or dense tables, and muted is only for marginal notes, and the rule never to fake formatting by hand."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/text/body#kurzbeschreibung",
        "summary": {
          "en": "Body conveys longer information in written form."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/text/body#beschreibung",
        "summary": {
          "en": "Body is a text component for running text in three sizes - small, default and large. It is the textual base for longer content and is designed for good readability."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/text/body#verwendungsregeln",
        "summary": {
          "en": "Use Body for running text that conveys facts. body--large: one intro paragraph per page on entry or landing pages. body--small: short supplementary text or dense tables, not key information. body--bold emphasises phrases; use inline links in text. body--muted: marginal notes or legal footnotes only."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/text/body#dos-und-donts",
        "summary": {
          "en": "Use Body only for running text, not for content that has its own component such as Link or Heading. Never fake formatting by hand - use the given sizes and styles. Use small and large sparingly and muted only in exceptions."
        }
      },
      {
        "id": "weitere-hinweise",
        "heading": "Weitere Hinweise",
        "url": "https://www.kern-ux.de/komponenten/text/body#weitere-hinweise",
        "summary": {
          "en": "Check whether extensive content is better split across several pages or sections."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Running-text component in three sizes with bold and muted styles; the base for longer readable content."
    },
    "whenToUse": [
      {
        "en": "When longer information should be presented as readable running text."
      }
    ],
    "dos": [
      {
        "en": "Use Body only for running text; use Link or Heading for content that has its own component."
      },
      {
        "en": "Use the given sizes and styles instead of manual bold or font-size changes."
      },
      {
        "en": "Use body--small and body--large sparingly, and body--muted only in exceptions."
      }
    ],
    "donts": [
      {
        "en": "Do not embed text as an image unless it can be fully adjusted, e.g. font size, colour and background."
      }
    ],
    "similar": [
      {
        "id": "subline"
      }
    ]
  },
