  "docs": {
    "url": "https://www.kern-ux.de/komponenten/badge",
    "summary": {
      "en": "Badge gives a very short status hint on a parent element, built from an icon and a short label. The page covers the 8px grid sizing, the four fixed tones and their uses, how the icon is hidden from or exposed to screen readers, the layout rules, and how to shrink a badge when space is tight."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/badge#kurzbeschreibung",
        "summary": {
          "en": "A badge gives a short status hint about a parent element."
        }
      },
      {
        "id": "badge-dimensionen",
        "heading": "Badge-Dimensionen",
        "url": "https://www.kern-ux.de/komponenten/badge#badge-dimensionen",
        "summary": {
          "en": "Badge scaling follows the system-wide 8px grid."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/badge#beschreibung",
        "summary": {
          "en": "A badge is a compact, non-interactive status hint on a parent element, e.g. whether a request was transmitted, is in progress or hit a problem. It pairs an icon with a short, precise label; drop the icon when space is tight if the meaning survives. Use Alert for immediate feedback on an action."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/badge#verwendungsregeln",
        "summary": {
          "en": "Badges give a very short status for orientation, mainly in overviews, and signal whether the user must act. Info: stable, no action. Success: done or ready. Warning: open, needs attention or action. Danger: user action required, so link to detail."
        }
      },
      {
        "id": "badge-mit-icon",
        "heading": "Badge mit Icon",
        "url": "https://www.kern-ux.de/komponenten/badge#badge-mit-icon",
        "summary": {
          "en": "The component sets aria-hidden=\"true\" on the icon by default, because the label usually carries the meaning. To expose the icon to screen readers, set aria-hidden to false and add an aria-label."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/badge#dos-und-donts",
        "summary": {
          "en": "Make sure badges do not cover other elements, do not change the colour scheme, and do not give one object several statuses."
        }
      },
      {
        "id": "weitere-hinweise",
        "heading": "Weitere Hinweise",
        "url": "https://www.kern-ux.de/komponenten/badge#weitere-hinweise",
        "summary": {
          "en": "When space is tight, reduce the badge to its label or icon if the meaning survives. More complex status messages are better communicated with Alert, Notification or Toast."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Compact, non-interactive status hint on a parent element: an icon plus a short label in one of four tones."
    },
    "whenToUse": [
      {
        "en": "When the status of an element must be shown compactly at a glance, especially in overviews and lists."
      }
    ],
    "dos": [
      {
        "en": "Make sure badges do not cover other elements."
      },
      {
        "en": "When space is tight, reduce the badge to its label or icon if the meaning survives."
      }
    ],
    "donts": [
      {
        "en": "Do not change the badge colour scheme."
      },
      {
        "en": "Do not give one object several statuses."
      },
      {
        "en": "Do not use badges for complex status information; use Alert, Notification or Toast instead."
      }
    ],
    "similar": [
