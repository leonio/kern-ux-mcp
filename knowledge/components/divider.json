  "docs": {
    "url": "https://www.kern-ux.de/komponenten/divider",
    "summary": {
      "en": "Divider is a simple horizontal line that separates content blocks into groups and can build hierarchy. The page covers full-width and narrower use, use inside other components with the space tokens, the fixed colour rule, and when free space works better and dividers should stay sparse."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/divider#kurzbeschreibung",
        "summary": {
          "en": "A divider visually separates content blocks into groups and can build hierarchy."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/divider#beschreibung",
        "summary": {
          "en": "A divider is a simple horizontal line. It can span the full page width or visually separate narrower content blocks, and can create hierarchy to show nested relationships."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/divider#verwendungsregeln",
        "summary": {
          "en": "Dividers separate larger sections with independent content and support the information hierarchy of the page. They can also be used inside other components; use the space tokens for the gaps above and below."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/divider#dos-und-donts",
        "summary": {
          "en": "Use dividers only in the prescribed colour."
        }
      },
      {
        "id": "weitere-hinweise",
        "heading": "Weitere Hinweise",
        "url": "https://www.kern-ux.de/komponenten/divider#weitere-hinweise",
        "summary": {
          "en": "Use dividers to structure elements when free space cannot group them, but use them sparingly - too many lines make an application look unclear."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Horizontal line that separates or groups content blocks; use sparingly and only in the prescribed colour."
    },
    "whenToUse": [
      {
        "en": "To separate larger sections of independent content or to structure elements that free space cannot group."
      }
    ],
    "dos": [
      {
        "en": "Use the space tokens for the gaps above and below a divider."
      }
    ],
    "donts": [
      {
        "en": "Do not use a divider in any colour other than the prescribed one."
      },
      {
        "en": "Do not use too many dividers; too many lines make an application look unclear."
      }
    ]
  },
