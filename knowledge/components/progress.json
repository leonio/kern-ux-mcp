{
  "id": "progress",
  "title": {
    "en": "Progress",
    "de": "Progress"
  },
  "status": "stable",
  "group": "feedback",
  "synonyms": {
    "de": [
      "Stepper",
      "Fortschrittsanzeige"
    ]
  },
  "links": {
    "docs": "https://www.kern-ux.de/komponenten/progress",
    "figma": "https://www.figma.com/community/file/1624024563231427311",
    "source": "https://gitlab.opencode.de/kern-ux/kern-ux-plain/-/tree/v2.8.2/src/scss/core/components/_progress.scss"
  },
  "docs": {
    "url": "https://www.kern-ux.de/komponenten/progress",
    "summary": {
      "en": "Progress shows the overall duration and progress of a multi-step process and gives continuous feedback on which step users are in and how many remain. It splits a longer process into equal segments; if extra steps become necessary the remaining segments can be re-divided. Users move linearly, or non-linearly where allowed, and the component is not interactive. A label is optional but recommended; it can sit above or below the bar and should name the active step and the total."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/progress#kurzbeschreibung",
        "summary": {
          "en": "Shows the overall duration and progress of a multi-step process."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/progress#beschreibung",
        "summary": {
          "en": "Gives continuous feedback on the current step and how many remain. The bar is split into equal steps and can be re-divided if the process grows. Users move linearly or non-linearly; the component is not interactive. A label is optional but recommended and names the active step and total."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/progress#verwendungsregeln",
        "summary": {
          "en": "Suited to processes that run in a fixed order, breaking a complex process into smaller, easier steps. Typical cases are steps in an online service, a registration process or a payment process."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/progress#dos-und-donts",
        "summary": {
          "en": "Do not use Progress for loading processes; use a Loader for those."
        }
      },
      {
        "id": "weitere-hinweise",
        "heading": "Weitere Hinweise",
        "url": "https://www.kern-ux.de/komponenten/progress#weitere-hinweise",
        "summary": {
          "en": "Use Progress for linear, chronological processes that require a fixed order of steps. Avoid it for very long or complex processes with more than ten steps, which can overwhelm users."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Shows progress through a multi-step process; use it for fixed-order flows, not for loading."
    },
    "whenToUse": [
      {
        "en": "Processes with a fixed sequence of steps, such as registration or payment flows."
      },
      {
        "en": "To break a complex process into smaller, easier-to-follow steps."
      }
    ],
    "dos": [
      {
        "en": "Use Progress for linear, chronological processes that need a fixed step order."
      }
    ],
    "donts": [
      {
        "en": "Do not use Progress for loading processes."
      },
      {
        "en": "Avoid Progress for very long or complex processes with more than ten steps; it can overwhelm users."
      }
    ],
    "similar": [
      {
        "id": "loader"
      }
    ]
  },
