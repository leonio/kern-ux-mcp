  "docs": {
    "url": "https://www.kern-ux.de/komponenten/form-inputs/checkboxes",
    "summary": {
      "en": "Checkbox lets users select one or more options independently. The page covers labelling each box, the group legend and optional hint, group-level error display, the states shared with Input except readonly, single use for binary decisions and list use, and switching to Radios when only one option may be chosen."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/checkboxes#kurzbeschreibung",
        "summary": {
          "en": "A checkbox selects one or more options."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/checkboxes#beschreibung",
        "summary": {
          "en": "A checkbox decides whether an option applies; several can be selected independently. Each has a short label; a check mark shows selection. A group needs an unambiguous legend, optionally marked \"optional\", and may have a hint. Group errors show below; all Input states apply except readonly."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/checkboxes#verwendungsregeln",
        "summary": {
          "en": "Use a single checkbox for binary decisions such as accepting privacy terms, or several for selection lists. Add a clear legend when the group's purpose is not clear from the preceding text. The selection is saved only on a confirming button. To allow just one option, use Radios."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/checkboxes#dos-und-donts",
        "summary": {
          "en": "Write labels as statements rather than questions, prefer positive wording without negations, and keep labels short enough to fit one line. Use a checkbox for simple decisions; a Select may fit complex choices. Avoid too many checkboxes."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Lets users select one or more independent options; use Radios when only one option may be chosen."
    },
    "whenToUse": [
      {
        "en": "For binary decisions such as accepting terms, or for lists in which several options may be selected independently."
      }
    ],
    "dos": [
      {
        "en": "Write the checkbox label as a statement rather than a question."
      },
      {
        "en": "Prefer positive wording and avoid negations in labels."
      },
      {
        "en": "Keep the label short enough to fit on one line."
      }
    ],
    "donts": [
      {
        "en": "Do not use so many checkboxes that the interface becomes cluttered and unclear."
      },
      {
        "en": "Do not use checkboxes when only one option may be chosen; use Radios instead."
      }
    ],
    "similar": [
      {
        "id": "radios"
      }
    ]
  },
