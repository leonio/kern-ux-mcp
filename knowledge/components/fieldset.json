  "docs": {
    "url": "https://www.kern-ux.de/komponenten/fieldset",
    "summary": {
      "en": "Fieldset groups related form fields and can build hierarchy, using a legend plus a group of elements. The page covers the kern-label classes and kern-label--large, hint text above and group errors below, vertical or horizontal arrangement via .kern-fieldset__body--horizontal, and when a Fieldset is required."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/fieldset#kurzbeschreibung",
        "summary": {
          "en": "A fieldset groups related form fields visually and semantically and can build hierarchy."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/fieldset#beschreibung",
        "summary": {
          "en": "A fieldset pairs a legend with a group of related form elements. The legend names the group concisely and aids orientation, especially for assistive technology; it uses kern-label, enlargeable with kern-label--large. Hints sit above the group, group errors below, and elements can be horizontal."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/fieldset#verwendungsregeln",
        "summary": {
          "en": "Group related form elements logically, whatever the input type, to improve structure and screen-reader support. It suits multi-part entries such as addresses or dates, and checkbox or radio groups answering one question. Group errors belong inside the fieldset, linked via aria-describedby."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/fieldset#dos-und-donts",
        "summary": {
          "en": "Use fieldsets only for related elements; they are mandatory for checkbox lists and radios, but not for a single checkbox such as a privacy consent. Use one only when a shared legend, error and hint make sense, label the legend clearly, never leave it empty, and never nest field groups."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Groups related form fields with a legend and shared hint or error; required for checkbox and radio groups."
    },
    "whenToUse": [
      {
        "en": "For multi-part entries such as addresses or date fields, and for checkbox or radio groups that relate to one question."
      }
    ],
    "dos": [
      {
        "en": "Use fieldsets only for elements that belong together in content."
      },
      {
        "en": "Use a Fieldset for checkbox lists and radio groups; it is mandatory there."
      },
      {
        "en": "Give the legend a clear and concise label and never leave it empty."
      },
      {
        "en": "Link group-level error messages inside the fieldset via aria-describedby."
      }
    ],
    "donts": [
      {
        "en": "Do not use a Fieldset for a single checkbox, e.g. accepting a privacy policy."
      },
      {
        "en": "Do not nest form field groups inside one another."
      }
    ]
  },
  "options": [
