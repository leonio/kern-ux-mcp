  "docs": {
    "url": "https://www.kern-ux.de/komponenten/form-inputs/file",
    "summary": {
      "en": "Input File lets users upload one or more files, either by dragging them onto the drop area or with a button that opens the file browser. One file appears next to the button with its name and extension; several are summarised, for example \"4 files selected\". State the allowed formats and the maximum size in the hint."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/file#kurzbeschreibung",
        "summary": {
          "en": "Input File enables the upload of one or more files."
        }
      },
      {
        "id": "disabled",
        "heading": "Disabled",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/file#disabled",
        "summary": {
          "en": "Avoid disabled, because it restricts accessibility."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/file#beschreibung",
        "summary": {
          "en": "Users drag files onto the drop area, which reacts while the pointer is over it, or open the file browser with a button. One file is shown by name and extension, several are summarised. Keep the label specific and put the allowed formats and the maximum size in the hint; read-only is not supported."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/file#verwendungsregeln",
        "summary": {
          "en": "Ask for an upload only when the service needs it, and check whether an API or the user's profile can supply the information instead. If you must ask, it should be something only the user can provide, such as a photo or a receipt. Allow several formats, validate automatically and describe errors."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/file#dos-und-donts",
        "summary": {
          "en": "Always state the allowed file types and the maximum size precisely."
        }
      },
      {
        "id": "weitere-hinweise",
        "heading": "Weitere Hinweise",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/file#weitere-hinweise",
        "summary": {
          "en": "Files uploaded together should belong together thematically; otherwise use several Input File components. The general Input Dos and Don'ts also apply."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Input File uploads one or more files by drag and drop or a file picker, and requires allowed formats and a size limit."
    },
    "whenToUse": [
      {
        "en": "Use Input File when users must provide something only they can, such as their own photo or a receipt."
      }
    ],
    "dos": [
      {
        "en": "Always state the allowed file types and the maximum size precisely."
      },
      {
        "en": "Keep the label short and specific about what should be uploaded."
      },
      {
        "en": "Validate uploads automatically and describe errors so users can fix them."
      },
      {
        "en": "Allow a range of file formats."
      }
    ],
    "donts": [
      {
        "en": "Don't ask for an upload unless the service really needs it."
      },
      {
        "en": "Don't request data an API or the user's profile can already supply."
      },
      {
        "en": "Don't group unrelated files in one Input File."
      },
      {
        "en": "Don't use disabled, because it restricts accessibility."
      }
    ]
  },
