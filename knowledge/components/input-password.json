  "docs": {
    "url": "https://www.kern-ux.de/komponenten/form-inputs/password",
    "summary": {
      "en": "Input Password masks what users type and offers a visibility toggle so typos can be spotted. A forgot-password link sits below the field and should lead to a form for requesting a new password. Autofill is switched off in password fields for privacy, and all input states except disabled and read-only are supported."
    },
    "sections": [
      {
        "id": "kurzbeschreibung",
        "heading": "Kurzbeschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/password#kurzbeschreibung",
        "summary": {
          "en": "Input Password allows a password to be entered or created."
        }
      },
      {
        "id": "beschreibung",
        "heading": "Beschreibung",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/password#beschreibung",
        "summary": {
          "en": "The general input properties apply. Characters appear masked as dots, and an icon button to the right shows or hides them, helping avoid typos. A link below the field leads to a form for requesting a new password. Autofill is off for privacy; all states except disabled and read-only are supported."
        }
      },
      {
        "id": "verwendungsregeln",
        "heading": "Verwendungsregeln",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/password#verwendungsregeln",
        "summary": {
          "en": "Input Password is used during sign-in or registration to enter a password. Do not use it for other text input."
        }
      },
      {
        "id": "dos-und-donts",
        "heading": "Dos und Don’ts",
        "url": "https://www.kern-ux.de/komponenten/form-inputs/password#dos-und-donts",
        "summary": {
          "en": "Explain the rules for creating a password during registration, and use autocomplete=\"current-password\" or autocomplete=\"new-password\". Do not drop autocomplete without good reason. On a failed sign-in, do not reveal whether the user name or the password was wrong."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Input Password masks the entry, adds a visibility toggle and keeps browser autofill for passwords off."
    },
    "dos": [
      {
        "en": "Use autocomplete=\"current-password\" or autocomplete=\"new-password\"."
      },
      {
        "en": "Explain the password rules in the help during registration."
      },
      {
        "en": "Return a neutral error message on a failed sign-in."
      }
    ],
    "donts": [
      {
        "en": "Don't drop autocomplete without good reason; browsers expect it."
      },
      {
        "en": "Don't reveal whether the user name or the password was wrong."
      },
      {
        "en": "Don't use Input Password for other text input."
      }
    ],
