  "docs": {
    "url": "https://www.kern-ux.de/design-system/foundations/icons",
    "summary": {
      "en": "KERN builds its icon set on Google Material Symbols, following the principle of evolving proven solutions instead of starting over. Icons carry simple actions in compact glyphs and help design elements stay consistent and recognisable. Use them deliberately and sparingly, only where they add real value, for example to mark an action or a status. The set is open, extensive and available in many variants; the detailed icon documentation lives in the components area."
    },
    "sections": [
      {
        "id": "icons-für-die-gestaltung-einsetzen",
        "heading": "Icons für die Gestaltung einsetzen",
        "url": "https://www.kern-ux.de/design-system/foundations/icons#icons-für-die-gestaltung-einsetzen",
        "summary": {
          "en": "Icons stand for simple actions in compact glyphs and support consistency and recognisability. Use them sparingly and only where they add value, such as marking an action or a status. KERN builds on the open Google Material Symbols collection; the components area documents icons in detail."
        }
      }
    ]
  },
  "knowledge": {
    "summary": {
      "en": "Icons convey simple actions and must be used sparingly; KERN builds on the open Google Material Symbols set."
    },
    "whenToUse": [
      {
        "en": "To label an action or a status compactly, or to reinforce recognition of a familiar element."
      }
    ],
    "dos": [
      {
        "en": "Use icons sparingly and only where they add real value, for example to mark an action or a status."
      }
    ],
    "donts": [
      {
        "en": "Don't scatter icons through the interface or use them as decoration where they carry no meaning."
      }
    ]
  },
