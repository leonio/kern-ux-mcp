{
	"name": "@leonio/kern-ux-mcp",
	"version": "0.0.0-semver",
	"type": "module",
	"description": "Model Context Protocol (MCP) language server providing Kern UX component generation and strict accessibility validation.",
	"license": "EUPL-1.2",
	"author": "Leon Ioannides <leonio@users.noreply.github.com>",
	"homepage": "https://github.com/leonio/kern-ux-mcp#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/leonio/kern-ux-mcp.git",
		"directory": "packages/stdio"
	},
	"bugs": {
		"url": "https://github.com/leonio/kern-ux-mcp/issues"
	},
	"keywords": [
		"mcp",
		"mcp-server",
		"mcp-language-server",
		"model-context-protocol",
		"kern-ux"
	],
	"bin": {
		"kern-ux-mcp": "./dist/index.js"
	},
	"files": [
		"dist",
		"sbom.cyclonedx.json",
		"README.md",
		"LICENSE.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"engines": {
		"node": ">=24.16.0"
	},
	"scripts": {
		"build": "tsx ../../tools/build/bundle.ts",
		"sbom": "tsx ../../tools/build/sbom.ts",
		"prepack": "node -e \"for (const file of ['README.md', 'LICENSE.md']) require('node:fs').copyFileSync('../../' + file, file)\"",
		"build:watch": "tsx ../../tools/build/bundle.ts --watch",
		"pack:mcpb": "tsx --conditions=@leonio/source ../../tools/build/mcpb.ts",
		"dev": "tsx --conditions=@leonio/source src/index.ts",
		"start": "node dist/index.js"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.1.0",
		"node-html-parser": "^9.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@leonio/kern-ux-core": "*"
	}
}
