{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!packages/core/src/ux/registry.json",
			"!knowledge",
			"!docs/v2-migration/evals",
			"!samples/basic-layout/assets",
			"!samples/tailwind-v4/src/kern-tokens.css",
			"!samples/tailwind-v4/src/kern-remap.css",
			"!**/__snapshots__"
		]
	},
	"linter": {
		"enabled": true
	},
	"overrides": [
		{
			"includes": ["samples/tailwind-v4/**/*.css"],
			"css": {
				"parser": {
					"tailwindDirectives": true
				}
			}
		},
		{
			"includes": ["packages/core/src/ux/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@modelcontextprotocol/*"],
										"message": "The domain (packages/core/src/ux) stays SDK-free; MCP wiring belongs in packages/core/src/mcp."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
